{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typedown.local/automation/v1.json",
  "title": "Typedown automation API v1",
  "description": "Params and results of every v1 method, and the error object (docs/automation-api-spec.md). Method params accept unknown fields (section 1.2); results may gain fields in later versions. Referenced as #/$defs/<method>.params and #/$defs/<method>.result.",
  "$defs": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Advances only when the text really changes; read together with instanceId."
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "documentId": {
      "$ref": "#/$defs/hex32"
    },
    "windowId": {
      "type": "string",
      "pattern": "^w[0-9a-f]{32}$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the exact text's UTF-8 bytes."
    },
    "text": {
      "type": "string",
      "pattern": "^[^\\r]*$",
      "description": "Document text; \"\\n\" line endings only."
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "scope": {
      "type": "string",
      "enum": [
        "app.read",
        "document.read",
        "document.write",
        "document.save",
        "window.focus",
        "settings.read",
        "settings.write",
        "window.view"
      ]
    },
    "lineEnding": {
      "enum": [
        "lf",
        "crlf",
        "cr"
      ]
    },
    "reveal": {
      "enum": [
        "none",
        "document",
        "change"
      ],
      "default": "none",
      "description": "document: bring the window to the front and show the document's tab. change (added in v1): the same, and a write then scrolls its first changed block into view when it is off screen, without moving the cursor; on open, create without text, undo and redo the same as document. Needs window.focus."
    },
    "origin": {
      "enum": [
        "user",
        "automation",
        "filesystem",
        "restore",
        "system"
      ]
    },
    "normalization": {
      "type": "object",
      "required": [
        "pendingNormalization",
        "sourceHash",
        "normalizedHash",
        "reasons",
        "classifierVersion"
      ],
      "properties": {
        "pendingNormalization": {
          "enum": [
            "none",
            "knownFormatting",
            "unknown",
            "unsafe"
          ]
        },
        "sourceHash": {
          "$ref": "#/$defs/contentHash"
        },
        "normalizedHash": {
          "anyOf": [
            {
              "$ref": "#/$defs/contentHash"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Stable English reasons, e.g. notEvaluated, fence-lost, formatting-changed."
        },
        "classifierVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "documentSummary": {
      "type": "object",
      "required": [
        "documentId",
        "windowId",
        "path",
        "title",
        "revision",
        "saved",
        "active",
        "lineEnding"
      ],
      "properties": {
        "documentId": {
          "$ref": "#/$defs/documentId"
        },
        "windowId": {
          "$ref": "#/$defs/windowId"
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "description": "Absolute path; null for an untitled document."
        },
        "title": {
          "type": "string"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "saved": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean",
          "description": "The active tab of its window."
        },
        "lineEnding": {
          "$ref": "#/$defs/lineEnding"
        }
      }
    },
    "presentation": {
      "type": "object",
      "required": [
        "windowVisible",
        "tabActive",
        "pageFramesPassed",
        "hostRenderPassed"
      ],
      "properties": {
        "windowVisible": {
          "type": "boolean"
        },
        "tabActive": {
          "type": "boolean"
        },
        "pageFramesPassed": {
          "type": "boolean"
        },
        "hostRenderPassed": {
          "type": "boolean"
        }
      }
    },
    "system.initialize.params": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "integer"
        },
        "client": {
          "type": "object",
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string"
            }
          }
        },
        "requestedScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "presentationAcknowledgement": {
              "type": "boolean"
            },
            "serverRequests": {
              "type": "boolean"
            }
          }
        }
      },
      "required": [
        "apiVersion",
        "client"
      ]
    },
    "system.initialize.result": {
      "type": "object",
      "required": [
        "apiVersion",
        "server",
        "instanceId",
        "clientSessionId",
        "grantedScopes",
        "deniedScopes",
        "maxMessageBytes",
        "methods",
        "capabilities"
      ],
      "properties": {
        "apiVersion": {
          "const": 1
        },
        "server": {
          "type": "object",
          "required": [
            "name",
            "version",
            "commit",
            "platform",
            "buildType"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "platform": {
              "type": "string"
            },
            "buildType": {
              "enum": [
                "application",
                "automationTestHost"
              ]
            }
          }
        },
        "instanceId": {
          "$ref": "#/$defs/hex32"
        },
        "clientSessionId": {
          "$ref": "#/$defs/hex32"
        },
        "grantedScopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scope"
          }
        },
        "deniedScopes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "scope",
              "reason"
            ],
            "properties": {
              "scope": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "unknown",
                  "notAvailable"
                ]
              }
            }
          }
        },
        "maxMessageBytes": {
          "type": "integer",
          "minimum": 1
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "scope",
              "schema"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "scope": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/scope"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "capabilities": {
          "type": "object",
          "required": [
            "replaceText",
            "presentationAcknowledgement",
            "events",
            "offsetEdits",
            "selectionEdits",
            "serverRequests"
          ],
          "properties": {
            "replaceText": {
              "type": "boolean"
            },
            "presentationAcknowledgement": {
              "type": "boolean"
            },
            "events": {
              "type": "boolean"
            },
            "offsetEdits": {
              "type": "boolean"
            },
            "selectionEdits": {
              "type": "boolean"
            },
            "serverRequests": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "system.ping.params": {
      "type": "object",
      "properties": {}
    },
    "system.ping.result": {
      "type": "object",
      "required": [
        "apiVersion",
        "instanceId"
      ],
      "properties": {
        "apiVersion": {
          "const": 1
        },
        "instanceId": {
          "$ref": "#/$defs/hex32"
        }
      }
    },
    "app.getState.params": {
      "type": "object",
      "properties": {}
    },
    "app.getState.result": {
      "type": "object",
      "required": [
        "instanceId",
        "version",
        "activeWindowId",
        "windowCount"
      ],
      "properties": {
        "instanceId": {
          "$ref": "#/$defs/hex32"
        },
        "version": {
          "type": "string"
        },
        "activeWindowId": {
          "anyOf": [
            {
              "$ref": "#/$defs/windowId"
            },
            {
              "type": "null"
            }
          ]
        },
        "windowCount": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "window.list.params": {
      "type": "object",
      "properties": {}
    },
    "window.list.result": {
      "type": "object",
      "required": [
        "windows"
      ],
      "properties": {
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "windowId",
              "active",
              "documentCount",
              "activeDocumentId"
            ],
            "properties": {
              "windowId": {
                "$ref": "#/$defs/windowId"
              },
              "active": {
                "type": "boolean"
              },
              "documentCount": {
                "$ref": "#/$defs/count"
              },
              "activeDocumentId": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/documentId"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "window.focus.params": {
      "type": "object",
      "properties": {
        "windowId": {
          "$ref": "#/$defs/windowId"
        }
      },
      "required": [
        "windowId"
      ]
    },
    "window.focus.result": {
      "type": "object",
      "required": [
        "windowId"
      ],
      "properties": {
        "windowId": {
          "$ref": "#/$defs/windowId"
        }
      }
    },
    "document.list.params": {
      "type": "object",
      "properties": {
        "windowId": {
          "$ref": "#/$defs/windowId"
        }
      }
    },
    "document.list.result": {
      "type": "object",
      "required": [
        "documents"
      ],
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/documentSummary"
          }
        }
      }
    },
    "document.get.params": {
      "type": "object",
      "properties": {
        "documentId": {
          "$ref": "#/$defs/documentId"
        },
        "consistency": {
          "enum": [
            "snapshot",
            "latest"
          ]
        },
        "include": {
          "type": "array",
          "items": {
            "enum": [
              "text",
              "headings"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "documentId",
        "consistency"
      ]
    },
    "document.get.result": {
      "allOf": [
        {
          "$ref": "#/$defs/documentSummary"
        },
        {
          "type": "object",
          "required": [
            "contentHash",
            "isCurrent",
            "normalization"
          ],
          "properties": {
            "contentHash": {
              "$ref": "#/$defs/contentHash"
            },
            "isCurrent": {
              "type": "boolean",
              "description": "Always true for consistency latest."
            },
            "normalization": {
              "$ref": "#/$defs/normalization"
            },
            "text": {
              "$ref": "#/$defs/text"
            },
            "headings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "index",
                  "level",
                  "text",
                  "slug"
                ],
                "properties": {
                  "index": {
                    "$ref": "#/$defs/count"
                  },
                  "level": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 6
                  },
                  "text": {
                    "type": "string"
                  },
                  "slug": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "document.open.params": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "windowId": {
          "$ref": "#/$defs/windowId"
        },
        "reveal": {
          "$ref": "#/$defs/reveal"
        }
      },
      "required": [
        "path"
      ]
    },
    "document.open.result": {
      "type": "object",
      "required": [
        "windowId",
        "documentId",
        "revision"
      ],
      "properties": {
        "windowId": {
          "$ref": "#/$defs/windowId"
        },
        "documentId": {
          "$ref": "#/$defs/documentId"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "document.create.params": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "windowId": {
          "$ref": "#/$defs/windowId"
        },
        "reveal": {
          "$ref": "#/$defs/reveal"
        },
        "normalizationPolicy": {
          "enum": [
            "requireKnownSafe",
            "allowUnknown"
          ],
          "default": "requireKnownSafe"
        }
      }
    },
    "document.create.result": {
      "type": "object",
      "required": [
        "windowId",
        "documentId",
        "revision",
        "contentHash"
      ],
      "properties": {
        "windowId": {
          "$ref": "#/$defs/windowId"
        },
        "documentId": {
          "$ref": "#/$defs/documentId"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        },
        "normalization": {
          "$ref": "#/$defs/normalization"
        }
      }
    },
    "document.focus.params": {
      "type": "object",
      "properties": {
        "documentId": {
          "$ref": "#/$defs/documentId"
        }
      },
      "required": [
        "documentId"
      ]
    },
    "document.focus.result": {
      "type": "object",
      "required": [
        "windowId",
        "documentId"
      ],
      "properties": {
        "windowId": {
          "$ref": "#/$defs/windowId"
        },
        "documentId": {
          "$ref": "#/$defs/documentId"
        }
      }
    },
    "writeResult": {
      "type": "object",
      "required": [
        "operationId",
        "revision",
        "contentHash",
        "saved",
        "origin",
        "normalization"
      ],
      "properties": {
        "operationId": {
          "$ref": "#/$defs/hex32"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        },
        "saved": {
          "type": "boolean"
        },
        "origin": {
          "const": "automation"
        },
        "normalization": {
          "$ref": "#/$defs/normalization"
        },
        "presentation": {
          "$ref": "#/$defs/presentation"
        }
      }
    },
    "document.replace.params": {
      "type": "object",
      "properties": {
        "documentId": {
          "$ref": "#/$defs/documentId"
        },
        "baseRevision": {
          "$ref": "#/$defs/revision"
        },
        "clientOperationId": {
          "type": "string",
          "maxLength": 256
        },
        "normalizationPolicy": {
          "enum": [
            "requireKnownSafe",
            "allowUnknown"
          ],
          "default": "requireKnownSafe"
        },
        "save": {
          "type": "boolean",
          "default": false
        },
        "reveal": {
          "$ref": "#/$defs/reveal"
        },
        "awaitPresentation": {
          "type": "boolean",
          "default": false,
          "description": "Only with reveal: document or change."
        },
        "text": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "documentId",
        "baseRevision",
        "text"
      ]
    },
    "document.replace.result": {
      "$ref": "#/$defs/writeResult"
    },
    "document.replaceText.params": {
      "type": "object",
      "properties": {
        "documentId": {
          "$ref": "#/$defs/documentId"
        },
        "baseRevision": {
          "$ref": "#/$defs/revision"
        },
        "clientOperationId": {
          "type": "string",
          "maxLength": 256
        },
        "normalizationPolicy": {
          "enum": [
            "requireKnownSafe",
            "allowUnknown"
          ],
          "default": "requireKnownSafe"
        },
        "save": {
          "type": "boolean",
          "default": false
        },
        "reveal": {
          "$ref": "#/$defs/reveal"
        },
        "awaitPresentation": {
          "type": "boolean",
          "default": false,
          "description": "Only with reveal: document or change."
        },
        "find": {
          "type": "string",
          "minLength": 1
        },
        "replacement": {
          "type": "string",
          "pattern": "^[^\\r]*$"
        },
        "expectedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "documentId",
        "baseRevision",
        "find",
        "replacement",
        "expectedCount"
      ]
    },
    "document.replaceText.result": {
      "$ref": "#/$defs/writeResult"
    },
    "document.undo.params": {
      "type": "object",
      "properties": {
        "documentId": {
          "$ref": "#/$defs/documentId"
        },
        "baseRevision": {
          "$ref": "#/$defs/revision"
        },
        "clientOperationId": {
          "type": "string",
          "maxLength": 256
        },
        "save": {
          "type": "boolean",
          "default": false
        },
        "reveal": {
          "$ref": "#/$defs/reveal"
        },
        "awaitPresentation": {
          "type": "boolean",
          "default": false,
          "description": "Only with reveal: document or change."
        }
      },
      "required": [
        "documentId",
        "baseRevision"
      ]
    },
    "document.undo.result": {
      "$ref": "#/$defs/writeResult"
    },
    "document.redo.params": {
      "type": "object",
      "properties": {
        "documentId": {
          "$ref": "#/$defs/documentId"
        },
        "baseRevision": {
          "$ref": "#/$defs/revision"
        },
        "clientOperationId": {
          "type": "string",
          "maxLength": 256
        },
        "save": {
          "type": "boolean",
          "default": false
        },
        "reveal": {
          "$ref": "#/$defs/reveal"
        },
        "awaitPresentation": {
          "type": "boolean",
          "default": false,
          "description": "Only with reveal: document or change."
        }
      },
      "required": [
        "documentId",
        "baseRevision"
      ]
    },
    "document.redo.result": {
      "$ref": "#/$defs/writeResult"
    },
    "document.save.params": {
      "type": "object",
      "properties": {
        "documentId": {
          "$ref": "#/$defs/documentId"
        },
        "baseRevision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "documentId"
      ]
    },
    "document.save.result": {
      "type": "object",
      "required": [
        "revision",
        "contentHash",
        "saved",
        "path"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "contentHash": {
          "$ref": "#/$defs/contentHash"
        },
        "saved": {
          "const": true
        },
        "path": {
          "type": "string"
        }
      }
    },
    "document.close.params": {
      "type": "object",
      "properties": {
        "documentId": {
          "$ref": "#/$defs/documentId"
        },
        "baseRevision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "documentId"
      ]
    },
    "document.close.result": {
      "type": "object",
      "required": [
        "documentId",
        "windowId",
        "closed"
      ],
      "properties": {
        "documentId": {
          "$ref": "#/$defs/documentId"
        },
        "windowId": {
          "$ref": "#/$defs/windowId"
        },
        "closed": {
          "const": true
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "data"
      ],
      "description": "error.code and error.data.kind always agree; x-codes lists the pairs.",
      "x-codes": {
        "not_initialized": -32001,
        "unsupported_version": -32002,
        "scope_required": -32003,
        "method_not_found": -32601,
        "invalid_params": -32602,
        "window_not_found": -32010,
        "document_not_found": -32011,
        "revision_conflict": -32012,
        "editor_not_ready": -32013,
        "content_sync_timeout": -32014,
        "read_only": -32015,
        "path_required": -32016,
        "save_failed": -32017,
        "content_not_roundtrippable": -32018,
        "match_count_mismatch": -32019,
        "setting_not_exposed": -32020,
        "setting_invalid": -32021,
        "persistence_failed": -32022,
        "presentation_timeout": -32023,
        "editor_inconsistent": -32024,
        "normalization_unclassified": -32025,
        "unsaved_changes": -32026,
        "message_too_large": -32030,
        "busy": -32031,
        "request_cancelled": -32032,
        "parse_error": -32700,
        "invalid_request": -32600,
        "internal_error": -32603
      },
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string",
          "description": "For people; may be localized. Programs read code and data.kind."
        },
        "data": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
