        ],
        "apply": "AppSettings.TextDirection ([EditorOption])"
      },
      "visibleIn": [
        "every editor page",
        "an open settings page"
      ],
      "sensitivity": "none",
      "restartRequired": false
    },
    {
      "key": "ui.language",
      "scope": "application",
      "type": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16,
        "pattern": "^(system|[a-z]{2,3}(-[A-Za-z]{2,4})?)$"
      },
      "windows": {
        "properties": [
          "Language"
        ],
        "apply": "SettingsViewModel.Language (\"default\" is \"system\"); a code outside Locale.SupportedLangs is setting_invalid"
      },
      "uno": {
        "properties": [
          "Language"
        ],
        "apply": "AppSettings.Language (\"\" is \"system\"); a code outside LocaleTables is setting_invalid"
      },
      "visibleIn": [
        "every window",
        "an open settings page",
        "every editor page"
      ],
      "sensitivity": "none",
      "restartRequired": false
    },
