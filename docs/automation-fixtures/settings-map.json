  "notExposed": [
    {
      "reason": "security: the automation switch itself; only the person at the settings page turns automation on or off",
      "windows": [
        "AllowLocalAutomation"
      ]
    },
    {
      "reason": "privacy: drawing PlantUML sends the document's diagram source to plantuml.com or the server set; only the person turns that on or chooses the server, not a program",
      "windows": [
        "RenderPlantUml",
        "PlantUmlServer"
      ],
      "uno": [
        "RenderPlantUml",
        "PlantUmlServer"
      ]
    },
    {
      "reason": "security: shows the person what a program changed; a program must not be able to hide its own edits",
      "windows": [
        "HighlightAutomationChanges"
      ]
    },
    {
      "reason": "windowLocal: layout or mode of one window (Core/Services/SettingsScope.cs); becomes a view command, not a setting",
      "windows": [
        "StartupPlacement",
        "SidePaneOpen",
        "SidePaneWidth",
        "SidePaneIndex",
        "StatusBarOpen",
        "FindReplaceDialogWidth",
        "Topmost"
      ]
    },
    {
      "reason": "viewState: editing mode of a window; exposed later as explicit view commands once mode switches are serialized with writes (spec 3.3)",
      "windows": [
        "SourceCode",
        "ReadOnly",
        "Typewriter",
        "FocusMode"
      ]
    },
    {
      "reason": "searchState: options of the find panel",
      "windows": [
        "SearchIsCaseSensitive",
        "SearchIsRegexp",
        "SearchIsWholeWord"
      ]
    },
    {
      "reason": "secret: never described, read or written through the API",
      "windows": [
        "HedgeDocPassword",
        "HedgeDocEmail",
        "HedgeDocServer"
      ]
    },
    {
      "reason": "internal: migration or database flags",
      "windows": [
        "FileExportDatabaseInitialized",
        "ImageUploadDatabaseInitialized"
      ]
    },
    {
      "reason": "path: may point outside the user's documents or change where files are written; needs its own review",
      "windows": [
        "StartupOpenFolder",
        "DefaultImageBasePath",
        "InsertClipboardImageCopyPath",
        "InsertLocalImageCopyPath",
        "InsertWebImageCopyPath"
      ]
    },
    {
      "reason": "code: user CSS runs in every editor page; not exposed",
      "windows": [
        "CustomCss"
      ]
    },
    {
      "reason": "candidate: application preference not yet reviewed for exposure (type, range, apply path, multi-window test)",
      "windows": [
        "RememberCursorPosition",
        "HedgeDocPublishReadOnly",
        "OpenFilesInNewTab",
        "AutoSave",
        "AutoReload",
        "AskBeforeReload",
        "FileStartupAction",
        "FolderStartupAction",
        "InsertClipboardImageAction",
        "InsertClipboardImageUseUploadConfigId",
        "InsertLocalImageAction",
        "InsertLocalImageUseUploadConfigId",
        "InsertWebImageAction",
        "InsertWebImageUseUploadConfigId",
        "DefaultImageUploadConfigId",
        "VimMode",
        "OpenFolderAfterExport",
        "AfterExport"
      ]
    }
  ]
}
