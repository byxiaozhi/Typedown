<UserControl
    x:Class="Typedown.Core.Controls.AboutApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:app="using:Typedown.Core"
    xmlns:u="using:Typedown.Core.Utilities"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <StackPanel Spacing="8">

        <TextBlock FontWeight="Bold" Text="{u:LocaleString Key=About.AboutApp}"/>

        <StackPanel Margin="2,0,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,4,0" Text="{x:Bind app:Config.AppName}"/>
                <TextBlock Text="{x:Bind local:AboutApp.GetAppVersion()}"/>
            </StackPanel>
            <TextBlock Text="{u:LocaleString Key=About.Introduction}"/>
        </StackPanel>

        <StackPanel Margin="-12,8,0,0">
            <!-- A fork: the original app's store page and credits site are not ours. The link is the edition's own
                 (Typedown.Automation.Brand): where this build is developed, or what it is built on. -->
            <HyperlinkButton Content="{x:Bind local:AboutApp.LinkText}" NavigateUri="{x:Bind local:AboutApp.LinkUrl}" />
        </StackPanel>

        <StackPanel Margin="0,8,0,0" Spacing="8" Orientation="Horizontal">
            <Button MinWidth="100" Name="FeedBackButton" Content="{u:LocaleString Key=About.SendFeedback}" Click="FeedBackButton_Click"/>
            <!-- The local logs (debug.log and the error reports), to attach to a report. -->
            <Button MinWidth="100" Name="OpenLogFolderButton" Content="{u:LocaleString Key=About.OpenLogFolder}" Click="OpenLogFolderButton_Click"/>
        </StackPanel>

        <!-- What an edition adds to the page (AboutApp.EditionSection); empty unless an edition sets it. -->
        <ContentPresenter x:Name="EditionSectionPresenter" Margin="0,16,0,0"/>

    </StackPanel>
</UserControl>
