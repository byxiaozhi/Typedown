<UserControl
    x:Class="Typedown.Core.Controls.SearchPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Typedown.Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="using:Typedown.Core.Utilities"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">
    <UserControl.Resources>
        <DataTemplate x:Key="ResultTemplate" x:DataType="local:SearchResultItem">
            <StackPanel Padding="0,6" Spacing="2">
                <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind RelativePath}" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind Snippet}" Opacity="0.85" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Height="49" Padding="8" ColumnSpacing="4" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefault}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <AutoSuggestBox 
                x:Name="SearchTextBox" 
                LostFocus="OnSearchTextBoxLostFocus" 
                TextChanged="OnSearchTextChanged"
                QueryIcon="Find"
                PlaceholderText="{u:LocaleString Key=FolderSearch.InFolderPlaceholder}"/>
            <Button Grid.Column="1" Width="32" Height="32" x:Name="CloseButton" Click="OnCloseButtonClick" Style="{ThemeResource EllipsisIconButtonStyle}">
                <FontIcon FontSize="10" Glyph="&#xe8bb;"/>
            </Button>
        </Grid>
        <TextBlock Grid.Row="1" Margin="12,8,12,4" Opacity="0.7" FontSize="12" Text="{x:Bind Status, Mode=OneWay}"/>
        <ListView Grid.Row="2" x:Name="ResultList" ItemsSource="{x:Bind Results}" ItemTemplate="{StaticResource ResultTemplate}"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnResultClick" Padding="4,0"/>
    </Grid>
</UserControl>
