<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Caret's warm-autumn theme, from the brand asset package's design-tokens.json (Light/Dark
         palettes). Overriding WinUI 3's own semantic theme resource keys (TextFillColorPrimaryBrush,
         CardStrokeColorDefaultBrush, ControlCornerRadius, SystemAccentColor, etc. — the same keys the
         Fluent default control templates already reference via {ThemeResource}) is what lets this
         cascade into stock controls (MenuBar, ContentDialog, Button, TreeView, ToggleSwitch, NumberBox
         in the Settings dialog...) without hand-editing every control's template. Custom Caret* brushes
         below are for the handful of places this project sets colors directly instead of through a
         stock semantic key (title bar text, folder tree icons via Icons.xaml).
         SystemAccentColorLight1-3/Dark1-3 are simple fixed-percentage tints toward white/black — not a
         perceptual color-space blend, just a reasonable approximation; nothing here depends on them
         being exact. -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Caret brand tokens -->
            <Color x:Key="CaretPrimaryColor">#A5522A</Color>
            <Color x:Key="CaretSecondaryColor">#D67A3C</Color>
            <Color x:Key="CaretBackgroundColor">#F8EBDD</Color>
            <Color x:Key="CaretSurfaceColor">#FFFFFF</Color>
            <Color x:Key="CaretSurfaceAltColor">#F2DCC2</Color>
            <Color x:Key="CaretTextPrimaryColor">#382A1B</Color>
            <Color x:Key="CaretTextSecondaryColor">#6B584B</Color>
            <Color x:Key="CaretBorderColor">#E3D5C6</Color>
            <Color x:Key="CaretFocusColor">#A5522A</Color>
            <SolidColorBrush x:Key="CaretPrimaryBrush" Color="{StaticResource CaretPrimaryColor}"/>
            <SolidColorBrush x:Key="CaretSecondaryBrush" Color="{StaticResource CaretSecondaryColor}"/>
            <SolidColorBrush x:Key="CaretBackgroundBrush" Color="{StaticResource CaretBackgroundColor}"/>
            <SolidColorBrush x:Key="CaretSurfaceBrush" Color="{StaticResource CaretSurfaceColor}"/>
            <SolidColorBrush x:Key="CaretSurfaceAltBrush" Color="{StaticResource CaretSurfaceAltColor}"/>
            <SolidColorBrush x:Key="CaretTextPrimaryBrush" Color="{StaticResource CaretTextPrimaryColor}"/>
            <SolidColorBrush x:Key="CaretTextSecondaryBrush" Color="{StaticResource CaretTextSecondaryColor}"/>
            <SolidColorBrush x:Key="CaretBorderBrush" Color="{StaticResource CaretBorderColor}"/>
            <SolidColorBrush x:Key="CaretFocusBrush" Color="{StaticResource CaretFocusColor}"/>
            <SolidColorBrush x:Key="CaretIconBrush" Color="{StaticResource CaretTextSecondaryColor}"/>
            <!-- Document tabs (MainWindow.Tabs.cs): the title bar is a darker band; the active tab takes
                 the page colour, so it joins the document below, with its icon in the brand colour;
                 the others are quieter, with a divider between them. -->
            <!-- Window sections, darkest to lightest (interface review F3): the tab band, then the command
                 row (menu and formatting toolbar), which the active tab joins, then the page. -->
            <SolidColorBrush x:Key="CaretTabStripBrush" Color="#EDD5BA"/>
            <SolidColorBrush x:Key="CaretCommandBarBrush" Color="{StaticResource CaretBackgroundColor}"/>
            <SolidColorBrush x:Key="CaretWindowBackgroundBrush" Color="{StaticResource CaretBackgroundColor}"/>
            <SolidColorBrush x:Key="CaretSidebarBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="CaretStatusBarBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="TabViewBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#F4E2CF"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#F6E7D7"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{StaticResource CaretBackgroundColor}"/>
            <SolidColorBrush x:Key="TabViewItemHeaderForeground" Color="#5E4A3C"/>
            <SolidColorBrush x:Key="TabViewItemHeaderForegroundPointerOver" Color="{StaticResource CaretTextPrimaryColor}"/>
            <SolidColorBrush x:Key="TabViewItemHeaderForegroundPressed" Color="{StaticResource CaretTextPrimaryColor}"/>
            <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="{StaticResource CaretTextPrimaryColor}"/>
            <SolidColorBrush x:Key="TabViewItemIconForeground" Color="#7A6454"/>
            <SolidColorBrush x:Key="TabViewItemIconForegroundPointerOver" Color="{StaticResource CaretTextSecondaryColor}"/>
            <SolidColorBrush x:Key="TabViewItemIconForegroundPressed" Color="{StaticResource CaretTextSecondaryColor}"/>
            <SolidColorBrush x:Key="TabViewItemIconForegroundSelected" Color="{StaticResource CaretPrimaryColor}"/>
            <SolidColorBrush x:Key="TabViewItemSeparator" Color="#B08C6A"/>
            <SolidColorBrush x:Key="TabViewButtonForeground" Color="{StaticResource CaretTextSecondaryColor}"/>
            <SolidColorBrush x:Key="TabViewButtonBackgroundPointerOver" Color="#F4E2CF"/>

            <!-- WinUI 3 semantic overrides -->
            <Color x:Key="SystemAccentColor">#A5522A</Color>
            <Color x:Key="SystemAccentColorLight1">#BC7D5F</Color>
            <Color x:Key="SystemAccentColorLight2">#D2A894</Color>
            <Color x:Key="SystemAccentColorLight3">#E8D4CA</Color>
            <Color x:Key="SystemAccentColorDark1">#7C3E20</Color>
            <Color x:Key="SystemAccentColorDark2">#522915</Color>
            <Color x:Key="SystemAccentColorDark3">#29140A</Color>

            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource CaretTextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource CaretTextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource CaretTextSecondaryColor}"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource CaretPrimaryColor}"/>

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource CaretBackgroundColor}"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource CaretSurfaceColor}"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource CaretBackgroundColor}"/>
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource CaretSurfaceColor}"/>
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource CaretSurfaceAltColor}"/>

            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource CaretSurfaceColor}"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource CaretSurfaceAltColor}"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource CaretBorderColor}"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultSolidColorBrush" Color="{StaticResource CaretBorderColor}"/>

            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource CaretSurfaceColor}"/>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource CaretSurfaceAltColor}"/>
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource CaretSurfaceAltColor}"/>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource CaretBorderColor}"/>
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource CaretBorderColor}"/>

            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource CaretSurfaceAltColor}"/>
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource CaretSurfaceAltColor}"/>

            <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="{StaticResource CaretFocusColor}"/>

            <!-- Selected list items (the sidebar): a quiet fill and the accent pill, as NavigationView
                 shows its selection, instead of ListView's accent-tinted fill. -->
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{StaticResource CaretSurfaceAltColor}"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{StaticResource CaretSurfaceAltColor}"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{StaticResource CaretSurfaceAltColor}"/>
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="{StaticResource CaretPrimaryColor}"/>

            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#2E7D32"/>
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#F59E0B"/>
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#DC2626"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- Caret brand tokens -->
            <Color x:Key="CaretPrimaryColor">#B55E2A</Color>
            <Color x:Key="CaretSecondaryColor">#F59E0B</Color>
            <Color x:Key="CaretBackgroundColor">#0E1220</Color>
            <Color x:Key="CaretSurfaceColor">#161B2A</Color>
            <Color x:Key="CaretSurfaceAltColor">#20283A</Color>
            <Color x:Key="CaretTextPrimaryColor">#EDEEF2</Color>
            <Color x:Key="CaretTextSecondaryColor">#A6B0C3</Color>
            <Color x:Key="CaretBorderColor">#2B3550</Color>
            <Color x:Key="CaretFocusColor">#F59E0B</Color>
            <SolidColorBrush x:Key="CaretPrimaryBrush" Color="{StaticResource CaretPrimaryColor}"/>
            <SolidColorBrush x:Key="CaretSecondaryBrush" Color="{StaticResource CaretSecondaryColor}"/>
            <SolidColorBrush x:Key="CaretBackgroundBrush" Color="{StaticResource CaretBackgroundColor}"/>
            <SolidColorBrush x:Key="CaretSurfaceBrush" Color="{StaticResource CaretSurfaceColor}"/>
            <SolidColorBrush x:Key="CaretSurfaceAltBrush" Color="{StaticResource CaretSurfaceAltColor}"/>
            <SolidColorBrush x:Key="CaretTextPrimaryBrush" Color="{StaticResource CaretTextPrimaryColor}"/>
            <SolidColorBrush x:Key="CaretTextSecondaryBrush" Color="{StaticResource CaretTextSecondaryColor}"/>
            <SolidColorBrush x:Key="CaretBorderBrush" Color="{StaticResource CaretBorderColor}"/>
            <SolidColorBrush x:Key="CaretFocusBrush" Color="{StaticResource CaretFocusColor}"/>
            <SolidColorBrush x:Key="CaretIconBrush" Color="{StaticResource CaretTextSecondaryColor}"/>
            <SolidColorBrush x:Key="CaretTabStripBrush" Color="#090C15"/>
            <SolidColorBrush x:Key="CaretCommandBarBrush" Color="#151A28"/>
            <SolidColorBrush x:Key="CaretWindowBackgroundBrush" Color="{StaticResource CaretBackgroundColor}"/>
            <SolidColorBrush x:Key="CaretSidebarBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="CaretStatusBarBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="TabViewBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#121726"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#0F1320"/>
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#151A28"/>
            <SolidColorBrush x:Key="TabViewItemHeaderForeground" Color="#8D97AB"/>
            <SolidColorBrush x:Key="TabViewItemHeaderForegroundPointerOver" Color="{StaticResource CaretTextPrimaryColor}"/>
            <SolidColorBrush x:Key="TabViewItemHeaderForegroundPressed" Color="{StaticResource CaretTextPrimaryColor}"/>
            <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="{StaticResource CaretTextPrimaryColor}"/>
            <SolidColorBrush x:Key="TabViewItemIconForeground" Color="#7C879C"/>
            <SolidColorBrush x:Key="TabViewItemIconForegroundPointerOver" Color="{StaticResource CaretTextSecondaryColor}"/>
            <SolidColorBrush x:Key="TabViewItemIconForegroundPressed" Color="{StaticResource CaretTextSecondaryColor}"/>
            <SolidColorBrush x:Key="TabViewItemIconForegroundSelected" Color="{StaticResource CaretSecondaryColor}"/>
            <SolidColorBrush x:Key="TabViewItemSeparator" Color="#4A5878"/>
            <SolidColorBrush x:Key="TabViewButtonForeground" Color="{StaticResource CaretTextSecondaryColor}"/>
            <SolidColorBrush x:Key="TabViewButtonBackgroundPointerOver" Color="#121726"/>

            <!-- WinUI 3 semantic overrides -->
            <!-- #B55E2A, not the brand's #8F4A22: that fill measured 2.82 : 1 against the page, below the
                 3 : 1 an "on" toggle needs (WCAG 1.4.11); this one is 4.08, with white text on it 4.57. -->
            <Color x:Key="SystemAccentColor">#B55E2A</Color>
            <Color x:Key="SystemAccentColorLight1">#C47E55</Color>
            <Color x:Key="SystemAccentColorLight2">#D39F7F</Color>
            <Color x:Key="SystemAccentColorLight3">#E1BFAA</Color>
            <Color x:Key="SystemAccentColorDark1">#884620</Color>
            <Color x:Key="SystemAccentColorDark2">#5B2F15</Color>
            <Color x:Key="SystemAccentColorDark3">#2D170B</Color>

            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource CaretTextPrimaryColor}"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource CaretTextSecondaryColor}"/>
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource CaretTextSecondaryColor}"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource CaretSecondaryColor}"/>

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource CaretBackgroundColor}"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource CaretSurfaceColor}"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource CaretBackgroundColor}"/>
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource CaretSurfaceColor}"/>
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource CaretSurfaceAltColor}"/>

            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource CaretSurfaceColor}"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource CaretSurfaceAltColor}"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource CaretBorderColor}"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultSolidColorBrush" Color="{StaticResource CaretBorderColor}"/>

            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource CaretSurfaceColor}"/>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource CaretSurfaceAltColor}"/>
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource CaretSurfaceAltColor}"/>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource CaretBorderColor}"/>
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource CaretBorderColor}"/>

            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource CaretSurfaceAltColor}"/>
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource CaretSurfaceAltColor}"/>

            <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="{StaticResource CaretFocusColor}"/>

            <!-- Selected list items (the sidebar): a quiet fill and the accent pill, as NavigationView
                 shows its selection, instead of ListView's accent-tinted fill. -->
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{StaticResource CaretSurfaceAltColor}"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{StaticResource CaretSurfaceAltColor}"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{StaticResource CaretSurfaceAltColor}"/>
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="{StaticResource CaretPrimaryColor}"/>

            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#34D399"/>
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#F59E0B"/>
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#F87171"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Geometry tokens, same in both themes. ControlCornerRadius/OverlayCornerRadius are real WinUI 3
         semantic keys the default Button/TextBox/NumberBox/ComboBox (Control) and Flyout/ContentDialog/
         MenuFlyout (Overlay) templates already read via {ThemeResource} — overriding them cascades the
         brand's rounder geometry to every stock control at once, no per-control template edits needed. -->
    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="CaretWindowCornerRadius">16</CornerRadius>

    <!-- Brand line icons, from the asset package's ui/icons/svg/*.svg — copied verbatim as Path.Data:
         XAML's Path Markup Syntax is deliberately close enough to SVG path syntax (same M/L/H/V/C/Z/A
         command letters, space- or comma-separated coordinates) that these drop in unchanged, no
         conversion needed. Only folder/file are wired up so far (MainWindow.xaml's folder tree,
         replacing the old ad hoc Segoe Fluent FontIcon glyphs); more of the set gets added here as
         later work actually uses them, rather than pre-populating icons nothing references yet.
         Lives in this file, not a separate Icons.xaml, because {ThemeResource CaretIconBrush} (and
         even a *standard* key like TextFillColorSecondaryBrush) only resolves correctly from within
         the same merged ResourceDictionary that declares it — cross-file ThemeResource lookups
         between sibling merged dictionaries crash the native XAML engine outright (0xc000027b, no
         diagnostic) in this WinUI 3 version. Confirmed the hard way, isolating property by property. -->
    <Style x:Key="CaretLineIconStyle" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="Stroke" Value="{ThemeResource CaretIconBrush}"/>
        <!-- No StrokeLineJoin/StrokeLineCap setter: separately confirmed StrokeLineCap crashes
             MarkupCompilePass2 outright (a build-time sibling of the same failure mode — neither
             StrokeLineCap nor WPF's StrokeStartLineCap/StrokeEndLineCap is a real dependency property
             on WinUI 3's Shape). Square/flat joins and caps only; a minor visual difference from the
             source SVGs (which use stroke-linecap="round"), not worth more native-crash roulette to
             recover. -->
    </Style>
</ResourceDictionary>
