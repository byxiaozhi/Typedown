                                <tk:SettingsCard.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="AboutAppNameText" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AboutAppVersionText" Opacity="0.7"/>
                                    </StackPanel>
                                </tk:SettingsCard.Header>
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE946;"/></tk:SettingsCard.HeaderIcon>
                                <StackPanel Orientation="Horizontal">
                                    <HyperlinkButton Content="{u:Loc Key=ViewSourceOnGitHub}" NavigateUri="https://github.com/fegyenc/Caret"/>
                                    <HyperlinkButton Content="{u:Loc Key=ThirdPartyNotices}" NavigateUri="https://github.com/fegyenc/Caret/blob/main/THIRD-PARTY-NOTICES.md"/>
                                </StackPanel>
                            </tk:SettingsCard>
                            <!-- Hidden in a Store install, where the Store delivers updates (Config.IsStoreInstall). -->
                            <StackPanel x:Name="UpdateSettingsPanel" Spacing="4">
                                <tk:SettingsCard Header="{u:Loc Key=CheckForUpdatesToggle_Header}" Description="{u:Loc Key=OnceADayCaretAsksGitHub}">
                                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE895;"/></tk:SettingsCard.HeaderIcon>
                                    <ToggleSwitch x:Name="CheckForUpdatesToggle" OnContent="{u:Loc Key=ToggleOn}" OffContent="{u:Loc Key=ToggleOff}" Toggled="CheckForUpdatesToggle_Toggled"/>
                                </tk:SettingsCard>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,4,0,0">
                                    <Button x:Name="CheckUpdatesNowButton" Content="{u:Loc Key=CheckUpdatesNowButton_Content}" Click="CheckUpdatesNow_Click"/>
                                    <ProgressRing x:Name="CheckUpdatesProgress" IsActive="False" Width="16" Height="16"/>
