        <!-- Reused for New File / New Folder / Rename in the folder tree's context menu — one TextBox
             ContentDialog rather than the original's inline TreeViewItem-embedded rename TextBox
             (FindName-swapping a TextBlock for a TextBox inside a recycled DataTemplate is fragile
             without x:Bind's named-element guarantees this project doesn't use). Title/PrimaryButtonText
             and the TextBox's starting text are set from code before ShowAsync. -->
        <ContentDialog x:Name="TextInputDialog" PrimaryButtonText="{u:Loc Key=TextInputDialog_Primary}" CloseButtonText="{u:Loc Key=TextInputDialog_Close}" DefaultButton="Primary">
            <TextBox x:Name="TextInputBox" AcceptsReturn="False"/>
        </ContentDialog>

        <!-- New since the fork: the original had PdfPrintSettings (Typedown.Core\Models\RuntimeModels
             \ExportPdfSettings.cs) as C# state but no host UI ever reached in this fork's port that let
             a user actually set them — Export > PDF just called PrintToPdfAsync(path, null) straight
             through, silently taking every CoreWebView2PrintSettings default. One of those defaults is
             a real, concrete gap for a markdown app specifically: ShouldPrintBackgrounds defaults to
             false, so every PDF export so far has been dropping code-block background tints and any
             other background-color styling without anyone asking it to. Margins and header/footer text
             aren't exposed here — WebView2's own defaults for those are reasonable and customizing them
             adds surface area without a concrete gap driving it, unlike backgrounds/orientation/size. -->
        <ContentDialog x:Name="PdfExportOptionsDialog" Title="{u:Loc Key=PdfExportOptionsDialog_Title}" PrimaryButtonText="{u:Loc Key=PdfExportOptionsDialog_Primary}" CloseButtonText="{u:Loc Key=PdfExportOptionsDialog_Close}" DefaultButton="Primary">
            <StackPanel Spacing="16" MinWidth="300">
                <StackPanel Spacing="4">
                    <TextBlock Text="{u:Loc Key=Orientation}"/>
                    <ComboBox x:Name="PdfOrientationComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="{u:Loc Key=Portrait}"/>
                        <ComboBoxItem Content="{u:Loc Key=Landscape}"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="{u:Loc Key=PageSize}"/>
                    <ComboBox x:Name="PdfPageSizeComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="{u:Loc Key=Letter85X11In}"/>
                        <ComboBoxItem Content="{u:Loc Key=A4827X1169}"/>
                        <ComboBoxItem Content="{u:Loc Key=Legal85X14In}"/>
                    </ComboBox>
                </StackPanel>
                <ToggleSwitch x:Name="PdfBackgroundsToggle" Header="{u:Loc Key=PdfBackgroundsToggle_Header}" IsOn="True"
                              OnContent="{u:Loc Key=ToggleOn}" OffContent="{u:Loc Key=ToggleOff}"/>
                <ToggleSwitch x:Name="PdfHeaderFooterToggle" Header="{u:Loc Key=PdfHeaderFooterToggle_Header}" IsOn="False"
                              OnContent="{u:Loc Key=ToggleOn}" OffContent="{u:Loc Key=ToggleOff}"/>
            </StackPanel>
        </ContentDialog>

        <!-- A short message at the bottom of the window that goes by itself (Copy as WhatsApp text); screen readers read it out. -->
        <Border x:Name="ToastHost" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed" IsHitTestVisible="False"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,56" Padding="14,8" MaxWidth="560" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <TextBlock x:Name="ToastText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
        </Border>
    </Grid>
</Window>
