                                <TextBlock Text="{u:Loc Key=Recent}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Favorites">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Path Data="M12 3L14.8 8.7L21 9.6L16.5 14L17.6 20.2L12 17.3L6.4 20.2L7.5 14L3 9.6L9.2 8.7Z" Style="{StaticResource CaretLineIconStyle}"/>
                                <TextBlock Text="{u:Loc Key=Favorites}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="AllFiles">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Path Data="M3 6H10L12 8H21V20H3Z" Style="{StaticResource CaretLineIconStyle}"/>
                                <TextBlock Text="{u:Loc Key=AllFiles}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Templates">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Path Data="M4 20L5 15L16 4L20 8L9 19Z M14 6L18 10" Style="{StaticResource CaretLineIconStyle}"/>
                                <TextBlock Text="{u:Loc Key=Templates}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Trash">
