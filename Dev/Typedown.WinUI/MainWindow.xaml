                                <TextBlock Text="{u:Loc Key=ConvertEmailsNav}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Review">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Path Data="M4 5H20V16H10L5 20V16H4Z M8 9H16 M8 12H13" Style="{StaticResource CaretLineIconStyle}"/>
                                <TextBlock Text="{u:Loc Key=ReviewNav}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="SpeechMarks">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Path Data="M9 6A3 3 0 0 1 15 6V11A3 3 0 0 1 9 11Z M5 11A7 7 0 0 0 19 11 M12 18V21 M9 21H15" Style="{StaticResource CaretLineIconStyle}"/>
                                <TextBlock Text="{u:Loc Key=SpeechNav}"/>
