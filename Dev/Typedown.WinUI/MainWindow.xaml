                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M12 5V19M5 12H19" Style="{StaticResource CaretLineIconStyle}" Stroke="White" Width="14" Height="14"/>
                            <TextBlock x:Name="NewNoteText" Text="{u:Loc Key=NewNote}"/>
