                    <Border x:Name="SidebarDivider" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,0"/>


                        <!-- Ported (structurally) from Typedown.Core\Controls\SidePaneControls\Pages\
                             FolderPage.xaml: a real ExplorerItem tree bound the same way — TreeView.
                             ItemsSource is the root item's Children (the root itself is never shown), a
                             DataTemplateSelector swaps between folder/file row templates, each folder
                             row's own ItemsSource is its Children for recursive nesting. Live file-system
                             watching and expand/collapse, drag-drop, and clipboard cut/copy/paste all
                             work now — see MainWindow.xaml.cs. CanDragItems/AllowDrop are deliberately
                             left off the TreeView itself (default false, same as the original): dragging
                             and dropping is handled per-item, on each TreeViewItem in the templates
                             above, not through the TreeView's own built-in same-list reorder. -->
                        <StackPanel x:Name="FolderSection" Visibility="Collapsed">
                            <Button x:Name="FolderHeaderButton" Click="FolderHeaderButton_Click"
                                    Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
