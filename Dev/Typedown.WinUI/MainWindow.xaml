                        </StackPanel>

                        <!-- Reimplemented, not ported: the original LeftPane/TocPage used a nested TreeView
                             bound through EditorViewModel.Toc (an ObservableCollection tree built from the
                             editor's StateChange messages) via a full AppViewModel DataContext. This is a
                             flat, indented ListView fed directly from the same StateChange.toc data over
                             our EventCenter, and it sends the same ScrollTo {slug} message the original's
                             JumpBySlug did — traced from EditorViewModel.cs and confirmed against
                             Muya/index.tsx's ScrollTo listener. -->
                        <!-- The document's headings, under their own heading so they don't read as part of
                             the navigation above. Collapses from the heading (Enter or Space on the button). -->
                        <!-- New since the fork: the Speech card (docs/speech-marks-design.md), the list of delivery marks
                             to put into a talk. Shown in Speech mode only; the buttons are built in MainWindow.Speech.cs. -->
                        <StackPanel x:Name="SpeechSection" Visibility="Collapsed">
                            <Button x:Name="SpeechHeaderButton" Click="SpeechHeaderButton_Click"
                                    Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Padding="16,10,12,4" Margin="4,0" AutomationProperties.Name="{u:Loc Key=SpeechHeader}">
                                <Grid>
                                    <TextBlock Text="{u:Loc Key=SpeechHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <FontIcon x:Name="SpeechChevron" Glyph="&#xE70E;" FontSize="10" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Button>
                            <TextBlock x:Name="SpeechStatusText" Margin="16,0,12,4" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                                       AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel x:Name="SpeechBody" Margin="16,0,12,8" Spacing="2"/>
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="OutlineHeaderButton" Click="OutlineHeaderButton_Click" Visibility="Collapsed"
                                Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Padding="16,10,12,4" Margin="4,0" AutomationProperties.Name="{u:Loc Key=OutlineHeader}">
                            <Grid>
                                <TextBlock Text="{u:Loc Key=OutlineHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <FontIcon x:Name="OutlineChevron" Glyph="&#xE70E;" FontSize="10" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </Button>
                        <ListView x:Name="TocListView" SelectionMode="None" IsItemClickEnabled="True" ItemClick="TocListView_ItemClick" MaxHeight="600">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Content}" Margin="{Binding Indent}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- New since the fork, not in the original at all: a small decorative footer,
                         matching the brand mockups' sidebar card ("Ideas grow here." over autumn-leaf
                         art). The mockup's own art is a photorealistic lake/mountain scene that isn't
                         actually in the delivered asset package (checked — only flat vector pieces
                         are: leaves/*.svg, decorative/atmosphere/*.svg), so this is composed from
                         those real brand assets instead of approximating a photo: the same leaf
                         silhouette path from leaves/leaf-copper.svg and leaves/leaf-orange.svg (copied
                         verbatim, like CaretLineIconStyle already does for folder/file), at two sizes
                         and rotations, over a soft two-stop gradient using the theme's own surface
                         colors — flat and illustrated, consistent with the rest of the brand pass
                         (UseMicaEffect defaults off for the same reason, see Themes/Caret.xaml). Purely
                         decorative: no click handler, hides with the rest of TocPane when Sidebar is
                         toggled off. -->
                    <Border Grid.Row="5" x:Name="DecorativeCard" Margin="8,8,8,10" Padding="12,10" Height="96"
                            CornerRadius="{ThemeResource OverlayCornerRadius}"
                            BorderBrush="{ThemeResource CaretBorderBrush}" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{ThemeResource CaretSurfaceAltColor}" Offset="0"/>
                                <GradientStop Color="{ThemeResource CaretBackgroundColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Path Data="M120 330C65 286 29 226 37 160C46 88 99 37 168 22C186 81 180 147 145 204C126 235 106 262 120 330Z"
                                  Fill="{ThemeResource CaretSecondaryBrush}" Opacity="0.55" Stretch="Uniform"
                                  Width="40" Height="60" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="10" CenterX="20" CenterY="30"/>
                                </Path.RenderTransform>
                            </Path>
                            <Path Data="M120 330C65 286 29 226 37 160C46 88 99 37 168 22C186 81 180 147 145 204C126 235 106 262 120 330Z"
                                  Fill="{ThemeResource CaretPrimaryBrush}" Opacity="0.75" Stretch="Uniform"
                                  Width="28" Height="42" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,26,20,0">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="-16" CenterX="14" CenterY="21"/>
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock Text="{u:Loc Key=IdeasGrowHere}" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                       FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="140"
                                       Foreground="{ThemeResource CaretTextPrimaryBrush}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" x:Name="EditorArea">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- New since the fork: "a newer Caret is available" (ShowUpdateNotice). Closing it just
                 hides it until the next daily check; "Skip this version" silences that version. -->
            <InfoBar Grid.Row="0" x:Name="UpdateInfoBar" IsOpen="False" Severity="Informational"
                     CornerRadius="0" BorderThickness="0,0,0,1">
                <InfoBar.ActionButton>
                    <Button Content="{u:Loc Key=Download}" Click="UpdateDownload_Click" Style="{StaticResource AccentButtonStyle}"/>
                </InfoBar.ActionButton>
                <HyperlinkButton Content="{u:Loc Key=SkipThisVersion}" Click="UpdateSkip_Click" Margin="-12,-8,0,4" Padding="12,2"/>
            </InfoBar>

            <!-- Formatting toolbar (interface review, phase 3): a CommandBar, so buttons that don't fit move
                 into its "More" menu in a narrow window, the whole bar is one tab stop with the arrow keys
                 inside it, and every button has a name and a tooltip with its shortcut. Line icons
                 throughout; headings are one button with a menu. Every command is one the editor already
                 handles (Format / UpdateParagraph, see RunFormatCommand). Hidden in Code/Split, where the
                 source editor doesn't understand them. Classic shows it in this row; Streamlined moves it
                 up into the command row (MainWindow.Layout.cs). -->
            <Border Grid.Row="1" x:Name="FormatToolbar" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1" Padding="4,0" Background="{ThemeResource CaretCommandBarBrush}">
                <CommandBar x:Name="FormatCommandBar" DefaultLabelPosition="Collapsed" IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto"
                            Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" TabFocusNavigation="Once"
                            XYFocusKeyboardNavigation="Enabled" AutomationProperties.Name="{u:Loc Key=FormattingToolbar}" Height="40">
                    <CommandBar.Resources>
                        <!-- 40 × 40 buttons, the size of the menu row they share in Streamlined -->
                        <Style TargetType="AppBarButton" BasedOn="{StaticResource DefaultAppBarButtonStyle}">
                            <Setter Property="Width" Value="40"/>
                            <Setter Property="Height" Value="40"/>
                        </Style>
                    </CommandBar.Resources>
                    <AppBarButton Label="{u:Loc Key=HeadingMenu}" ToolTipService.ToolTip="{u:Loc Key=HeadingMenu}">
                        <AppBarButton.Icon><FontIcon Glyph="H" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"/></AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="{u:Loc Key=Heading1}" Tag="p:heading 1" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+1"/>
                                <MenuFlyoutItem Text="{u:Loc Key=Heading2}" Tag="p:heading 2" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+2"/>
                                <MenuFlyoutItem Text="{u:Loc Key=Heading3}" Tag="p:heading 3" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+3"/>
                                <MenuFlyoutItem Text="{u:Loc Key=Heading4}" Tag="p:heading 4" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+4"/>
                                <MenuFlyoutItem Text="{u:Loc Key=Heading5}" Tag="p:heading 5" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+5"/>
                                <MenuFlyoutItem Text="{u:Loc Key=Heading6}" Tag="p:heading 6" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+6"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="{u:Loc Key=Paragraph}" Tag="p:paragraph" Click="FormatCommand_Click" KeyboardAcceleratorTextOverride="Ctrl+0"/>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarSeparator/>
                    <AppBarButton Tag="f:strong" Click="FormatCommand_Click" Label="{u:Loc Key=Bold}" ToolTipService.ToolTip="{u:Loc Key=BoldCtrlB}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8DD;" FontSize="16"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Tag="f:em" Click="FormatCommand_Click" Label="{u:Loc Key=Italic}" ToolTipService.ToolTip="{u:Loc Key=ItalicCtrlI}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8DB;" FontSize="16"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Tag="f:del" Click="FormatCommand_Click" Label="{u:Loc Key=Strikethrough}" ToolTipService.ToolTip="{u:Loc Key=Strikethrough}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xEDE0;" FontSize="16"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Tag="f:inline_code" Click="FormatCommand_Click" Label="{u:Loc Key=InlineCode}" ToolTipService.ToolTip="{u:Loc Key=InlineCode}">
                        <AppBarButton.Icon><FontIcon Glyph="&lt;/&gt;" FontFamily="Consolas" FontSize="13"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Tag="f:link" Click="FormatCommand_Click" Label="{u:Loc Key=Link}" ToolTipService.ToolTip="{u:Loc Key=Link}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE71B;" FontSize="16"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator/>
                    <AppBarButton Tag="p:ul-bullet" Click="FormatCommand_Click" Label="{u:Loc Key=BulletedList}" ToolTipService.ToolTip="{u:Loc Key=BulletedList}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8FD;" FontSize="16"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Tag="p:ol-order" Click="FormatCommand_Click" Label="{u:Loc Key=NumberedList}" ToolTipService.ToolTip="{u:Loc Key=NumberedList}">
                        <AppBarButton.Icon><FontIcon Glyph="1." FontFamily="Segoe UI" FontSize="15"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Tag="p:ul-task" Click="FormatCommand_Click" Label="{u:Loc Key=TaskList}" ToolTipService.ToolTip="{u:Loc Key=TaskListCtrlShiftX}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE73A;" FontSize="16"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Tag="p:blockquote" Click="FormatCommand_Click" Label="{u:Loc Key=Quote}" ToolTipService.ToolTip="{u:Loc Key=QuoteCtrlShiftQ}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE9B2;" FontSize="16"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Tag="p:pre" Click="FormatCommand_Click" Label="{u:Loc Key=CodeBlock}" ToolTipService.ToolTip="{u:Loc Key=CodeBlockCtrlShiftK}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE943;" FontSize="16"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator/>
                    <AppBarButton Tag="insert:table" Click="FormatCommand_Click" Label="{u:Loc Key=TableMenu}" ToolTipService.ToolTip="{u:Loc Key=InsertTableCtrlShiftT}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE80A;" FontSize="16"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Tag="insert:image" Click="FormatCommand_Click" Label="{u:Loc Key=InsertImage}" ToolTipService.ToolTip="{u:Loc Key=InsertImage}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xEB9F;" FontSize="16"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Tag="p:hr" Click="FormatCommand_Click" Label="{u:Loc Key=HorizontalLine}" ToolTipService.ToolTip="{u:Loc Key=HorizontalLine}">
                        <AppBarButton.Icon><FontIcon Glyph="&#x2014;" FontFamily="Segoe UI" FontSize="15"/></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
            </Border>

            <WebView2 Grid.Row="2" x:Name="EditorView"/>

            <!-- New since the fork: the start page, after the last document is closed (the window
                 stays open for the next one — MainWindow.Tabs.cs ShowStartPage). -->
            <ScrollViewer Grid.Row="1" Grid.RowSpan="2" x:Name="StartPage" Visibility="Collapsed"
                          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <StackPanel MaxWidth="760" Margin="40,48,40,32" Spacing="20">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{u:Loc Key=StartPageTitle}" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock Text="{u:Loc Key=StartPageSubtitle}" Opacity="0.8" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button Click="StartNewNote_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Path Data="M6 3H14L19 8V21H6Z M14 3V8H19 M12.5 11V17 M9.5 14H15.5" Style="{StaticResource CaretLineIconStyle}" Stroke="{ThemeResource CaretPrimaryBrush}" Width="24" Height="24" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{u:Loc Key=StartNewNote}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{u:Loc Key=StartNewNoteText}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" Click="StartOpenFile_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Path Data="M3 6H10L12 8H21V20H3Z" Style="{StaticResource CaretLineIconStyle}" Stroke="{ThemeResource CaretPrimaryBrush}" Width="24" Height="24" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{u:Loc Key=StartOpenFile}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{u:Loc Key=StartOpenFileText}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Grid.Row="1" Click="HomeConvertButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Path Data="M6 3H13L18 8V21H6Z M13 3V8H18 M9 14L12 17L15 14 M12 10V17" Style="{StaticResource CaretLineIconStyle}" Stroke="{ThemeResource CaretPrimaryBrush}" Width="24" Height="24" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{u:Loc Key=HomeConvertTitle}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{u:Loc Key=HomeConvertSubtitle}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" Click="HomeEmailsButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Path Data="M3 6H21V18H3Z M3 6L12 13L21 6" Style="{StaticResource CaretLineIconStyle}" Stroke="{ThemeResource CaretPrimaryBrush}" Width="24" Height="24" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{u:Loc Key=HomeEmailsTitle}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{u:Loc Key=HomeEmailsSubtitle}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="StartPageRecentHeader" Text="{u:Loc Key=StartPagePinnedRecent}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <!-- Favourites first, then recent files: name, the folders it's in, when it changed, and
                         a star to add or remove the favourite. Delete removes a row from Recent (the file
                         itself is never touched). -->
                    <ListView x:Name="StartPageRecentList" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="StartPageRecent_ItemClick" KeyDown="StartPageRecentList_KeyDown"
                              AutomationProperties.Name="{u:Loc Key=StartPagePinnedRecent}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" MinHeight="44" ToolTipService.ToolTip="{Binding FullPath}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M6 3H14L19 8V21H6Z M14 3V8H19" Style="{StaticResource CaretLineIconStyle}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Folder}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Modified}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <Button Grid.Column="3" Click="StartPageFavorite_Click" Tag="{Binding FullPath}" Background="Transparent" BorderThickness="0"
                                            Width="32" Height="32" Padding="0" ToolTipService.ToolTip="{u:Loc Key=FavoriteMenuItem}" AutomationProperties.Name="{u:Loc Key=FavoriteMenuItem}">
                                        <Grid>
                                            <FontIcon Glyph="&#xE734;" FontSize="14" Visibility="{Binding NotFavoriteVisibility}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <FontIcon Glyph="&#xE735;" FontSize="14" Visibility="{Binding FavoriteVisibility}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>

            <!-- Reimplemented, not ported: the original FindReplace.xaml used a ThemeShadow +
                 GridSplitter-resizable floating panel bound through FloatViewModel/EditorViewModel/
                 AppViewModel, none of which exist yet. The actual search/highlight/replace logic
                 lives entirely in the web editor (Muya) already — this panel is just an input bar
                 that speaks the same Search/Find/Replace/SearchOpenChange wire messages the original
                 native side sent, traced from Typedown.Editor/src/components/Muya/index.tsx. -->
            <Border Grid.Row="2" x:Name="FindReplacePanel" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="16" MinWidth="480" Padding="8" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FindTextBox" PlaceholderText="{u:Loc Key=FindTextBox_Placeholder}" KeyDown="FindTextBox_KeyDown" TextChanged="FindTextBox_TextChanged"/>
                        <Button Grid.Column="1" Content="&#x2193;" Click="FindNext_Click" ToolTipService.ToolTip="{u:Loc Key=FindNext}"/>
                        <Button Grid.Column="2" Content="&#x2191;" Click="FindPrev_Click" ToolTipService.ToolTip="{u:Loc Key=FindPrevious}"/>
                        <Button Grid.Column="3" Content="&#x2715;" Click="CloseFind_Click" ToolTipService.ToolTip="{u:Loc Key=Close}"/>
                    </Grid>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ReplaceTextBox" PlaceholderText="{u:Loc Key=ReplaceTextBox_Placeholder}"/>
                        <Button Grid.Column="1" Content="{u:Loc Key=Replace}" Click="Replace_Click"/>
                        <Button Grid.Column="2" Content="{u:Loc Key=ReplaceAll}" Click="ReplaceAll_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox x:Name="CaseSensitiveCheck" Content="{u:Loc Key=CaseSensitiveCheck_Content}" Checked="SearchOption_Changed" Unchecked="SearchOption_Changed"/>
                        <CheckBox x:Name="WholeWordCheck" Content="{u:Loc Key=WholeWordCheck_Content}" Checked="SearchOption_Changed" Unchecked="SearchOption_Changed"/>
                        <CheckBox x:Name="RegexCheck" Content="{u:Loc Key=RegexCheck_Content}" Checked="SearchOption_Changed" Unchecked="SearchOption_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- New since the fork: Convert to Markdown (MainWindow.Convert.cs). Covers the toolbar and
                 editor while open; files or folders can be dropped anywhere on it. -->
            <Grid Grid.Row="1" Grid.RowSpan="2" x:Name="ConvertPage" Visibility="Collapsed"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  AllowDrop="True" DragOver="ConvertPage_DragOver" Drop="ConvertPage_Drop">
                <ScrollViewer>
                    <StackPanel MaxWidth="880" Margin="32,20,32,32" Spacing="18">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Click="ConvertBack_Click" Background="Transparent" BorderThickness="0" Width="36" Height="36" Padding="0"
                                    VerticalAlignment="Center" ToolTipService.ToolTip="{u:Loc Key=ConvertBackToEditor}">
                                <Path Data="M15 5L8 12L15 19" Style="{StaticResource CaretLineIconStyle}" Width="16" Height="16"/>
                            </Button>
                            <TextBlock Grid.Column="1" Text="{u:Loc Key=ConvertTitle}" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{u:Loc Key=ConvertIntro}" TextWrapping="Wrap" Opacity="0.85" FontSize="15" Margin="0,-6,0,0"/>

                        <!-- Drop zone -->
                        <Grid MinHeight="190" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Rectangle x:Name="ConvertDropOutline" Stroke="{ThemeResource CaretPrimaryBrush}" StrokeThickness="1.5" StrokeDashArray="5 4"
                                       RadiusX="12" RadiusY="12" Opacity="0.6"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Padding="24">
                                <Path Data="M6 3H13L18 8V21H6Z M13 3V8H18 M9 14L12 17L15 14 M12 10V17" Style="{StaticResource CaretLineIconStyle}"
                                      Stroke="{ThemeResource CaretPrimaryBrush}" Width="34" Height="34" HorizontalAlignment="Center"/>
                                <TextBlock Text="{u:Loc Key=ConvertDropHere}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Button Content="{u:Loc Key=ConvertChooseFiles}" Click="ConvertChooseFiles_Click" Style="{StaticResource AccentButtonStyle}"/>
                                    <Button Content="{u:Loc Key=ConvertChooseFolder}" Click="ConvertChooseFolder_Click"/>
                                </StackPanel>
                                <TextBlock Text="{u:Loc Key=ConvertFormats}" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- Outlook emails: their own card, because a whole thread cleaned up and anonymised
                             is a different job from converting a document -->
                        <Border x:Name="ConvertEmailCard" CornerRadius="12" Padding="20,16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CaretPrimaryBrush}" BorderThickness="1.5">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="12" VerticalAlignment="Top" Background="{ThemeResource CaretPrimaryBrush}">
                                    <Path Data="M3 6H21V18H3Z M3 6L12 13L21 6" Style="{StaticResource CaretLineIconStyle}" Stroke="White"
                                          Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{u:Loc Key=ConvertEmailCardTitle}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <Border CornerRadius="9" Padding="8,1" VerticalAlignment="Center" Background="{ThemeResource CaretPrimaryBrush}">
                                            <TextBlock Text="{u:Loc Key=NewBadge}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{u:Loc Key=ConvertEmailCardText}" TextWrapping="Wrap" FontSize="13" Opacity="0.85"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="10" VerticalAlignment="Center" MinWidth="190">
                                    <Button Click="ConvertChooseEmails_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                                            ToolTipService.ToolTip="{u:Loc Key=ConvertChooseEmailsTip}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Data="M3 6H21V18H3Z M3 6L12 13L21 6" Style="{StaticResource CaretLineIconStyle}" Stroke="{ThemeResource AccentButtonForeground}"
                                                  Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="{u:Loc Key=ConvertChooseEmails}"/>
                                        </StackPanel>
                                    </Button>
                                    <ToggleSwitch x:Name="ConvertRedactToggle" Header="{u:Loc Key=ConvertMaskPersonalData}"
                                                  ToolTipService.ToolTip="{u:Loc Key=ConvertMaskPersonalDataTip}"
                                                  OnContent="{u:Loc Key=ToggleOn}" OffContent="{u:Loc Key=ToggleOff}" Toggled="ConvertRedactToggle_Toggled"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Options -->
                        <Grid ColumnSpacing="24" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{u:Loc Key=ConvertSaveTo}"/>
                                <ComboBox x:Name="ConvertOutputComboBox" HorizontalAlignment="Stretch" SelectionChanged="ConvertOutputComboBox_SelectionChanged">
                                    <ComboBoxItem Content="{u:Loc Key=ConvertSaveNextTo}" Tag="next"/>
                                    <ComboBoxItem x:Name="ConvertOutputFolderItem" Content="{u:Loc Key=ConvertSaveToFolder}" Tag="folder"/>
                                </ComboBox>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="ConvertImagesToggle" Header="{u:Loc Key=ConvertExtractImages}"
                                          OnContent="{u:Loc Key=ToggleOn}" OffContent="{u:Loc Key=ToggleOff}" Toggled="ConvertImagesToggle_Toggled"/>
                            <ToggleSwitch Grid.Row="1" Grid.ColumnSpan="2" x:Name="ConvertExplorerMenuToggle" Header="{u:Loc Key=ConvertExplorerMenu}"
                                          ToolTipService.ToolTip="{u:Loc Key=ConvertExplorerMenuTip}"
                                          OnContent="{u:Loc Key=ToggleOn}" OffContent="{u:Loc Key=ToggleOff}" Toggled="ConvertExplorerMenuToggle_Toggled"/>
                        </Grid>

                        <!-- Summary of this session's conversions -->
                        <Border x:Name="ConvertSummaryPanel" Visibility="Collapsed" CornerRadius="8" Padding="16,12"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ConvertSummaryTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ConvertSummaryDetail" Opacity="0.8" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="ConvertCopyAllButton" Click="ConvertCopyAll_Click" Style="{StaticResource AccentButtonStyle}"
                                            ToolTipService.ToolTip="{u:Loc Key=ConvertCopyAllTip}">
                                        <TextBlock x:Name="ConvertCopyAllText" Text="{u:Loc Key=ConvertCopyAll}"/>
                                    </Button>
                                    <Button Content="{u:Loc Key=ConvertClear}" Click="ConvertClear_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ListView x:Name="ConvertResultsList" SelectionMode="None" IsItemClickEnabled="False" Padding="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="12,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="46" Height="30" CornerRadius="4" Background="{Binding BadgeBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{Binding SourcePath}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ProgressRing IsActive="{Binding IsConverting}" Visibility="{Binding ProgressVisibility}" Width="12" Height="12"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Visibility="{Binding ActionsVisibility}" VerticalAlignment="Center">
                                                <Button Content="{u:Loc Key=Open}" Click="ConvertOpenResult_Click" Tag="{Binding}"/>
                                                <Button Content="{u:Loc Key=Copy}" Click="ConvertCopyResult_Click" Tag="{Binding}"/>
                                                <Button Click="ConvertRevealResult_Click" Tag="{Binding}" Padding="8,5"
                                                        ToolTipService.ToolTip="{u:Loc Key=RevealInFileExplorer}">
                                                    <Path Data="M3 6H10L12 8H21V20H3Z" Style="{StaticResource CaretLineIconStyle}" Width="14" Height="14"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Why Markdown -->
                        <Border CornerRadius="12" Padding="20,16" BorderBrush="{ThemeResource CaretBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{u:Loc Key=ConvertWhyTitle}" FontWeight="SemiBold" FontSize="15"/>
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{u:Loc Key=ConvertWhyTokensTitle}" FontWeight="SemiBold" Foreground="{ThemeResource CaretPrimaryBrush}"/>
                                        <TextBlock Text="{u:Loc Key=ConvertWhyTokensText}" TextWrapping="Wrap" FontSize="13" Opacity="0.85"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{u:Loc Key=ConvertWhyStructureTitle}" FontWeight="SemiBold" Foreground="{ThemeResource CaretPrimaryBrush}"/>
                                        <TextBlock Text="{u:Loc Key=ConvertWhyStructureText}" TextWrapping="Wrap" FontSize="13" Opacity="0.85"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="{u:Loc Key=ConvertWhyPrivateTitle}" FontWeight="SemiBold" Foreground="{ThemeResource CaretPrimaryBrush}"/>
                                        <TextBlock Text="{u:Loc Key=ConvertWhyPrivateText}" TextWrapping="Wrap" FontSize="13" Opacity="0.85"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            </Grid>
        </Grid>

        <!-- New since the fork: a status bar, matching the brand mockups' bottom bar. The original
             WPF app's own StatusBar.xaml (Typedown.Core\Controls\EditorControls\StatusBar.xaml) is the
             real reference for what's shown here, not the mockup art — the mockup's literal "Ln 18,
             Col 1" isn't reproducible against Muya (a block-based WYSIWYG editor with no line/column
             concept; that only exists in the CodeMirror source view, which isn't wired up as a real
             editing mode here — see CHANGES.md's Known Issues). The word/character count toggle is
             real, sourced from the same StateChange wordCount payload TocListView's table of contents
             already reads (UpdateWordCount, subscribed alongside UpdateToc). -->
        <!-- Left: the document's size. Right: its format and encoding, and the view mode (moved here
             from the title bar, interface review D2 — it belongs to the document, not the window). -->
        <Border Grid.Row="3" x:Name="StatusBar" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="6,0" Height="28"
                Background="{ThemeResource CaretStatusBarBrush}">
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" x:Name="StatusBarTrackText" FontSize="12" VerticalAlignment="Center" Margin="10,0" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button Grid.Column="0" x:Name="StatusBarWordCountButton" Click="StatusBarWordCountButton_Click"
                        Background="Transparent" BorderThickness="0" Padding="6,2" FontSize="12" MinHeight="24"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Content="{u:Loc Key=StatusBarWordCountButton_Content}" ToolTipService.ToolTip="{u:Loc Key=StatusBarWordCountButton_ToolTip}"/>
                <TextBlock Grid.Column="2" x:Name="StatusBarFormatText" Text="{u:Loc Key=Markdown}" FontSize="12" VerticalAlignment="Center" Margin="6,0,10,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <!-- View | Code | Split. Three ToggleButtons kept mutually exclusive in code (SetViewMode);
                     this SDK has no segmented control. -->
                <Border Grid.Column="3" x:Name="StatusViewModeHost">
                <StackPanel x:Name="ViewModeSwitch" Orientation="Horizontal" VerticalAlignment="Center"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="2" Spacing="2">
                    <ToggleButton x:Name="ViewModeViewButton" Content="{u:Loc Key=ViewModeViewButton_Content}" Tag="view" Click="ViewModeButton_Click"
                                  FontSize="11" Padding="8,0" MinHeight="20" Height="20" BorderThickness="0" CornerRadius="3"
                                  ToolTipService.ToolTip="{u:Loc Key=ViewModeViewButton_ToolTip}"/>
                    <ToggleButton x:Name="ViewModeCodeButton" Content="{u:Loc Key=ViewModeCodeButton_Content}" Tag="code" Click="ViewModeButton_Click"
                                  FontSize="11" Padding="8,0" MinHeight="20" Height="20" BorderThickness="0" CornerRadius="3"
                                  ToolTipService.ToolTip="{u:Loc Key=ViewModeCodeButton_ToolTip}"/>
                    <ToggleButton x:Name="ViewModeSplitButton" Content="{u:Loc Key=ViewModeSplitButton_Content}" Tag="split" Click="ViewModeButton_Click"
                                  FontSize="11" Padding="8,0" MinHeight="20" Height="20" BorderThickness="0" CornerRadius="3"
                                  ToolTipService.ToolTip="{u:Loc Key=ViewModeSplitButton_ToolTip}"/>
                </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- New since the fork, not in the original at all: a VS Code-style "Go to File" quick open
             (Ctrl+K, the search icon in the title bar, or File > Go to File...). Positioned with
             Grid.Row="0" Grid.RowSpan="3" so it overlays the whole window, not just the editor pane
             (unlike FindReplacePanel above, which only needs to sit over the editor). Candidate list is
             every markdown file under the open folder (QuickOpenAllFiles, built in ShowQuickOpen),
             falling back to Recent Files when no folder is open — filtered client-side as you type
             rather than a real fuzzy-match algorithm, which is enough for a project-sized file list. -->
        <Border x:Name="QuickOpenPanel" Visibility="Collapsed" Grid.Row="0" Grid.RowSpan="3"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,80,0,0"
                MinWidth="480" MaxWidth="560" Padding="8" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="4">
                <TextBox x:Name="QuickOpenTextBox" PlaceholderText="{u:Loc Key=QuickOpenTextBox_Placeholder}"
                         TextChanged="QuickOpenTextBox_TextChanged" KeyDown="QuickOpenTextBox_KeyDown"/>
                <!-- Tapped, not ItemClick: ItemClick is documented as the SelectionMode="None" pattern
                     (Single selection is meant to be read via SelectionChanged/SelectedItem instead).
                     Single selection is kept for arrow-key highlight tracking (MoveQuickOpenSelection)
                     and Enter-to-open (SelectedItem) — Tapped fires on every click regardless of
                     whether that click changes the selection (e.g. clicking the already-selected first
                     result, the common case since a result is always pre-selected as you type), which
                     ItemClick is not guaranteed to under Single selection. -->
                <ListView x:Name="QuickOpenListView" MaxHeight="360" SelectionMode="Single"
                          ItemTemplate="{StaticResource NavFileEntryTemplate}" Tapped="QuickOpenListView_Tapped"/>
            </StackPanel>
        </Border>

        <!-- Settings (interface review, phase 2): a page in the window instead of the old 420 px dialog,
             so a change shows on the app behind it straight away. Opens with Ctrl+, the gear or File >
             Settings; Esc or Back returns to the document. Categories on the left (NavigationView), each
             a column of SettingsCards (Windows Community Toolkit, the same controls PowerToys uses), and
             a search box that finds a setting by name (Ctrl+F). The controls keep their names and
             handlers from the dialog; LoadSettingsIntoDialog still fills them when the page opens. -->
        <Grid x:Name="SettingsPage" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              PreviewKeyDown="SettingsPage_PreviewKeyDown" KeyboardAcceleratorPlacementMode="Hidden">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SettingsSearchAccelerator_Invoked"/>
            </Grid.KeyboardAccelerators>
            <Grid.Resources>
                <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                    <Setter Property="Margin" Value="1,28,0,6"/>
                </Style>
                <Style x:Key="SettingsComboStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                    <Setter Property="MinWidth" Value="220"/>
                </Style>
            </Grid.Resources>
            <!-- A plain two-column page rather than a NavigationView: NavigationView sized its content
                 wider than the window here, cutting the cards off on the right. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Padding="4,4,4,8" RowSpacing="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button x:Name="SettingsBackButton" Click="SettingsBack_Click" Background="Transparent" BorderThickness="0" Width="40" Height="36"
                        ToolTipService.ToolTip="{u:Loc Key=Back}" AutomationProperties.Name="{u:Loc Key=Back}">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                </Button>
                <AutoSuggestBox Grid.Row="1" x:Name="SettingsSearchBox" PlaceholderText="{u:Loc Key=SearchSettings}" QueryIcon="Find" Margin="8,0,8,8"
                                TextChanged="SettingsSearchBox_TextChanged" SuggestionChosen="SettingsSearchBox_SuggestionChosen"
                                QuerySubmitted="SettingsSearchBox_QuerySubmitted"/>
                <ListView Grid.Row="2" x:Name="SettingsNavList" SelectionMode="Single" SelectionChanged="SettingsNavList_SelectionChanged"
                          AutomationProperties.Name="{u:Loc Key=SettingsDialog_Title}">
                        <ListViewItem Tag="General" AutomationProperties.Name="{u:Loc Key=SettingsGeneral}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE713;" FontSize="16"/>
                                <TextBlock Text="{u:Loc Key=SettingsGeneral}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Appearance" AutomationProperties.Name="{u:Loc Key=SettingsAppearance}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE790;" FontSize="16"/>
                                <TextBlock Text="{u:Loc Key=SettingsAppearance}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Layout" AutomationProperties.Name="{u:Loc Key=SettingsLayout}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE7C4;" FontSize="16"/>
                                <TextBlock Text="{u:Loc Key=SettingsLayout}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Editor" AutomationProperties.Name="{u:Loc Key=SettingsEditor}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8D2;" FontSize="16"/>
                                <TextBlock Text="{u:Loc Key=SettingsEditor}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Speech" AutomationProperties.Name="{u:Loc Key=SettingsSpeech}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8BD;" FontSize="16"/>
                                <TextBlock Text="{u:Loc Key=SettingsSpeech}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Tabs" AutomationProperties.Name="{u:Loc Key=SettingsTabsWindows}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8A7;" FontSize="16"/>
                                <TextBlock Text="{u:Loc Key=SettingsTabsWindows}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Convert" AutomationProperties.Name="{u:Loc Key=SettingsConvert}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8B5;" FontSize="16"/>
                                <TextBlock Text="{u:Loc Key=SettingsConvert}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Images" AutomationProperties.Name="{u:Loc Key=SettingsImages}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xEB9F;" FontSize="16"/>
                                <TextBlock Text="{u:Loc Key=SettingsImages}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="Keyboard" AutomationProperties.Name="{u:Loc Key=SettingsKeyboard}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE765;" FontSize="16"/>
                                <TextBlock Text="{u:Loc Key=SettingsKeyboard}"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="About" AutomationProperties.Name="{u:Loc Key=About}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE946;" FontSize="16"/>
                                <TextBlock Text="{u:Loc Key=About}"/>
                            </StackPanel>
                        </ListViewItem>
                </ListView>
            </Grid>
                <ScrollViewer Grid.Column="1" x:Name="SettingsScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SettingsContent" Margin="36,20,36,40" HorizontalAlignment="Left">
                        <TextBlock x:Name="SettingsPageTitle" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12"/>

                        <!-- General -->
                        <StackPanel x:Name="SettingsGeneralPanel" Tag="General" Spacing="4">
                            <tk:SettingsCard Header="{u:Loc Key=Language}">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xF2B7;"/></tk:SettingsCard.HeaderIcon>
                                <!-- Applied on the next start, because the window's text is resolved as it
                                     loads. Language names are written in their own language. -->
                                <ComboBox x:Name="LanguageComboBox" Style="{StaticResource SettingsComboStyle}" SelectionChanged="LanguageComboBox_SelectionChanged">
                                    <ComboBoxItem Content="{u:Loc Key=UseSystemLanguage}" Tag="default"/>
                                    <ComboBoxItem Content="English" Tag="en"/>
                                    <ComboBoxItem Content="Français" Tag="fr"/>
                                    <ComboBoxItem Content="Español" Tag="es"/>
                                    <ComboBoxItem Content="Polski" Tag="pl"/>
                                    <ComboBoxItem Content="Português (Brasil)" Tag="pt"/>
                                </ComboBox>
                            </tk:SettingsCard>
                            <TextBlock x:Name="LanguageRestartText" Text="{u:Loc Key=LanguageRestartNote}" Visibility="Collapsed"
                                       TextWrapping="Wrap" Opacity="0.8" FontSize="12" Margin="16,0,0,4"/>
                            <tk:SettingsCard Header="{u:Loc Key=AutoSaveToggle_Header}">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE74E;"/></tk:SettingsCard.HeaderIcon>
                                <ToggleSwitch x:Name="AutoSaveToggle" OnContent="{u:Loc Key=ToggleOn}" OffContent="{u:Loc Key=ToggleOff}" Toggled="AutoSaveToggle_Toggled"/>
                            </tk:SettingsCard>
                            <TextBlock Text="{u:Loc Key=OnStartupHeader}" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                            <tk:SettingsCard Header="{u:Loc Key=OnStartupOpen}">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8A5;"/></tk:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="FileStartupActionComboBox" Style="{StaticResource SettingsComboStyle}" SelectionChanged="FileStartupActionComboBox_SelectionChanged">
                                    <ComboBoxItem Content="{u:Loc Key=ANewBlankNote}" Tag="None"/>
                                    <ComboBoxItem Content="{u:Loc Key=TheLastFileYouHadOpen}" Tag="OpenLast"/>
                                </ComboBox>
                            </tk:SettingsCard>
                            <!-- FolderStartupAction defaults to OpenLast; this is the way to turn that off. -->
                            <tk:SettingsCard Header="{u:Loc Key=Folder}">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B7;"/></tk:SettingsCard.HeaderIcon>
                                <StackPanel Spacing="6" HorizontalAlignment="Right">
                                    <ComboBox x:Name="FolderStartupActionComboBox" Style="{StaticResource SettingsComboStyle}" HorizontalAlignment="Right" SelectionChanged="FolderStartupActionComboBox_SelectionChanged">
                                        <ComboBoxItem Content="{u:Loc Key=DonTReopenAFolder}" Tag="None"/>
                                        <ComboBoxItem Content="{u:Loc Key=TheLastFolderYouHadOpen}" Tag="OpenLast"/>
                                        <ComboBoxItem Content="{u:Loc Key=AlwaysThisFolder}" Tag="OpenFolder"/>
                                    </ComboBox>
                                    <Grid x:Name="StartupFolderPickerGrid" ColumnSpacing="8" Visibility="Collapsed" Width="320">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="StartupOpenFolderBox" IsReadOnly="True"/>
                                        <Button Grid.Column="1" Content="{u:Loc Key=Browse}" Click="StartupOpenFolderBrowse_Click"/>
                                    </Grid>
                                </StackPanel>
                            </tk:SettingsCard>
                        </StackPanel>

                        <!-- Appearance -->
                        <StackPanel x:Name="SettingsAppearancePanel" Tag="Appearance" Spacing="4" Visibility="Collapsed">
                            <InfoBar x:Name="ContrastThemeInfoBar" IsOpen="False" IsClosable="False" Severity="Informational"
                                     Message="{u:Loc Key=ContrastThemeActive}" Margin="0,0,0,8"/>
                            <tk:SettingsCard Header="{u:Loc Key=Theme}" Description="{u:Loc Key=ThemeDescription}">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE793;"/></tk:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="ThemeComboBox" Style="{StaticResource SettingsComboStyle}" SelectionChanged="ThemeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="{u:Loc Key=UseSystemSetting}" Tag="Default"/>
                                    <ComboBoxItem Content="{u:Loc Key=Light}" Tag="Light"/>
                                    <ComboBoxItem Content="{u:Loc Key=Dark}" Tag="Dark"/>
                                </ComboBox>
                            </tk:SettingsCard>
                            <!-- Arrow keys move through the schemes and each one applies straight away, so
                                 they can be compared on the app itself. -->
                            <tk:SettingsExpander x:Name="ColorSchemeExpander" Header="{u:Loc Key=ColorScheme}" Description="{u:Loc Key=ColorSchemeDescription}" IsExpanded="True">
                                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE790;"/></tk:SettingsExpander.HeaderIcon>
                                <TextBlock x:Name="ColorSchemeNameText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <tk:SettingsExpander.Items>
                                    <tk:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
                                        <GridView x:Name="ColorSchemeGridView" SelectionMode="Single" SelectionChanged="ColorSchemeGridView_SelectionChanged"
                                                  AutomationProperties.Name="{u:Loc Key=ColorScheme}" Margin="-4,4,0,4"/>
                                    </tk:SettingsCard>
                                </tk:SettingsExpander.Items>
                            </tk:SettingsExpander>
                            <tk:SettingsCard x:Name="AccentSourceCard" Header="{u:Loc Key=AccentColor}" Description="{u:Loc Key=AccentColorDescription}">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE771;"/></tk:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="AccentSourceComboBox" Style="{StaticResource SettingsComboStyle}" SelectionChanged="AccentSourceComboBox_SelectionChanged">
                                    <ComboBoxItem Content="{u:Loc Key=AccentScheme}" Tag="scheme"/>
                                    <ComboBoxItem Content="{u:Loc Key=AccentWindows}" Tag="windows"/>
                                </ComboBox>
                            </tk:SettingsCard>
                            <tk:SettingsCard x:Name="WindowMaterialCard" Header="{u:Loc Key=WindowMaterial}" Description="{u:Loc Key=WindowMaterialDescription}">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE737;"/></tk:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="WindowMaterialComboBox" Style="{StaticResource SettingsComboStyle}" SelectionChanged="WindowMaterialComboBox_SelectionChanged">
                                    <ComboBoxItem Content="{u:Loc Key=MaterialSolid}" Tag="solid"/>
                                    <ComboBoxItem Content="Mica" Tag="mica"/>
                                    <ComboBoxItem Content="Mica Alt" Tag="micaalt"/>
                                </ComboBox>
                            </tk:SettingsCard>
                            <!-- One area at a time over the scheme; colours that would be hard to read aren't offered
                                 (the contrast guard, MainWindow.Sections.cs). Kept per theme. -->
                            <tk:SettingsExpander x:Name="SectionColorsExpander" Header="{u:Loc Key=SectionColors}" Description="{u:Loc Key=SectionColorsDescription}">
                                <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xF0E2;"/></tk:SettingsExpander.HeaderIcon>
                                <tk:SettingsExpander.Items>
                                    <tk:SettingsCard Header="{u:Loc Key=SectionBand}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock x:Name="SectionBandContrast" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <ComboBox x:Name="SectionBandComboBox" Tag="band" Style="{StaticResource SettingsComboStyle}" SelectionChanged="SectionComboBox_SelectionChanged"
                                                      AutomationProperties.Name="{u:Loc Key=SectionBand}"/>
