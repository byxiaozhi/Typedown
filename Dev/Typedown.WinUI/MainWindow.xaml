                        <FontIcon x:Name="SidebarRailGlyph" Glyph="&#xE76C;" FontSize="12"/>
                    </Button>

                    <Button Grid.Row="0" x:Name="NewNoteButton" Click="NewMenuItem_Click" AutomationProperties.Name="{u:Loc Key=NewNote}"
