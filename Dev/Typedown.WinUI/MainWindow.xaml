                                            </Button>
                                            <Button Grid.Column="3" Tag="{Binding Index}" Click="TrackReject_Click" IsEnabled="{Binding CanAct}" Padding="6,4" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                                                    ToolTipService.ToolTip="{Binding RejectTip}" AutomationProperties.Name="{Binding RejectTip}">
                                                <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                        <Button Content="{u:Loc Key=ReviewAddComment}" Click="AddCommentMenuItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8"/>
                        <Button Content="{u:Loc Key=ReviewAcceptAll}" Click="AcceptAllMenuItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8"/>
                        <Button Content="{u:Loc Key=ReviewRejectAll}" Click="RejectAllMenuItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8"/>
                        <Button Content="{u:Loc Key=ReviewDeleteAllComments}" Click="DeleteAllCommentsMenuItem_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8"/>
                        <ToggleSwitch x:Name="ReviewPanelMarksToggle" Header="{u:Loc Key=ReviewMarksToggle_Header}" Margin="0,8,0,0"
