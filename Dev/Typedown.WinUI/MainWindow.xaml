                        <StackPanel x:Name="SettingsImagesPanel" Tag="Images" Spacing="4" Visibility="Collapsed">
                            <tk:SettingsCard Header="{u:Loc Key=SavePastedImagesTo}">
                                <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEB9F;"/></tk:SettingsCard.HeaderIcon>
                                <ComboBox x:Name="PastedImageLocationComboBox" Style="{StaticResource SettingsComboStyle}" SelectionChanged="PastedImageLocationComboBox_SelectionChanged">
                                    <ComboBoxItem Content="{u:Loc Key=PicturesCaret}" Tag="None"/>
                                    <ComboBoxItem Content="{u:Loc Key=AnImagesFolderNextToThe}" Tag="CopyToPath"/>
                                </ComboBox>
                            </tk:SettingsCard>
                        </StackPanel>

                        <!-- Keyboard: a read-only list of the shortcuts that exist, kept in sync by hand with
                             the KeyboardAccelerators in the menus. The original's rebinding page had no
                             bindings left to rebind in this port. -->
                        <StackPanel x:Name="SettingsKeyboardPanel" Tag="Keyboard" Spacing="4" Visibility="Collapsed">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="16,12">
                                <Grid ColumnSpacing="24" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{u:Loc Key=New}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{u:Loc Key=CtrlN}" Opacity="0.7"/>
                                    <TextBlock Grid.Row="1" Text="{u:Loc Key=NewWindow}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{u:Loc Key=CtrlShiftN}" Opacity="0.7"/>
                                    <TextBlock Grid.Row="2" Text="{u:Loc Key=Open}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{u:Loc Key=CtrlO}" Opacity="0.7"/>
                                    <TextBlock Grid.Row="3" Text="{u:Loc Key=GoToFile}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{u:Loc Key=CtrlK}" Opacity="0.7"/>
                                    <TextBlock Grid.Row="4" Text="{u:Loc Key=Save}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{u:Loc Key=CtrlS}" Opacity="0.7"/>
                                    <TextBlock Grid.Row="5" Text="{u:Loc Key=SaveAs}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{u:Loc Key=CtrlShiftS}" Opacity="0.7"/>
                                    <TextBlock Grid.Row="6" Text="{u:Loc Key=Print}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{u:Loc Key=CtrlP}" Opacity="0.7"/>
                                    <TextBlock Grid.Row="7" Text="{u:Loc Key=FindReplace}"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{u:Loc Key=CtrlF}" Opacity="0.7"/>
                                    <TextBlock Grid.Row="8" Text="{u:Loc Key=NextPreviousTab}"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="Ctrl+Tab / Ctrl+Shift+Tab" Opacity="0.7"/>
                                    <TextBlock Grid.Row="9" Text="{u:Loc Key=CloseDocumentMenuItem}"/>
                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{u:Loc Key=CtrlW}" Opacity="0.7"/>
                                    <TextBlock Grid.Row="10" Text="{u:Loc Key=CloseWindow}"/>
                                    <TextBlock Grid.Row="10" Grid.Column="1" Text="{u:Loc Key=CtrlShiftW}" Opacity="0.7"/>
                                    <TextBlock Grid.Row="11" Text="{u:Loc Key=SettingsDialog_Title}"/>
                                    <TextBlock Grid.Row="11" Grid.Column="1" Text="Ctrl+," Opacity="0.7"/>
                                    <TextBlock Grid.Row="12" Text="{u:Loc Key=ViewModeMenu}"/>
                                    <TextBlock Grid.Row="12" Grid.Column="1" Text="Ctrl+/" Opacity="0.7"/>
                                    <TextBlock Grid.Row="13" Text="{u:Loc Key=MoveBetweenAreas}"/>
                                    <TextBlock Grid.Row="13" Grid.Column="1" Text="F6 / Shift+F6" Opacity="0.7"/>
                                    <TextBlock Grid.Row="14" Text="{u:Loc Key=LayoutDistraction}"/>
                                    <TextBlock Grid.Row="14" Grid.Column="1" Text="F11" Opacity="0.7"/>
                                </Grid>
