                                <Button x:Name="TrackPreviousButton" Content="{u:Loc Key=ReviewTrackPrev}" Click="TrackPrevious_Click" Padding="8,4" FontSize="12"/>
                                <Button x:Name="TrackNextButton" Content="{u:Loc Key=ReviewTrackNext}" Click="TrackNext_Click" Padding="8,4" FontSize="12"/>
                            </StackPanel>
                            <Button x:Name="TrackUndoAcceptButton" Content="{u:Loc Key=ReviewTrackUndoAccept}" Click="TrackUndoAccept_Click" Padding="8,4" HorizontalAlignment="Left" FontSize="12" Visibility="Collapsed"/>
                            <Button x:Name="WriteReviewButton" Content="{u:Loc Key=ReviewTrackWrite}" Click="WriteReview_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" FontSize="12" IsEnabled="False"/>
                            <TextBlock x:Name="TrackNotExactText" Text="{u:Loc Key=ReviewTrackNotExact}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" Visibility="Collapsed"/>
                            <ListView x:Name="TrackChangesList" MaxHeight="420" SelectionMode="None" IsItemClickEnabled="True" ItemClick="TrackChangesList_ItemClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="2" Margin="0,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Glyph}" VerticalAlignment="Center" Opacity="0.8"/>
