                                            <Button Grid.Column="2" Tag="{Binding Index}" Click="TrackAccept_Click" IsEnabled="{Binding CanAct}" Padding="6,4" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                                                    ToolTipService.ToolTip="{Binding AcceptTip}" AutomationProperties.Name="{Binding AcceptTip}">
