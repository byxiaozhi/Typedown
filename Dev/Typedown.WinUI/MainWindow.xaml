                <RadioMenuFlyoutItem x:Name="ViewModeCodeMenuItem" Text="{u:Loc Key=ViewModeCodeMenuItem_Text}" GroupName="ViewMode" Tag="code" Click="ViewModeMenuItem_Click"/>
                <RadioMenuFlyoutItem x:Name="ViewModeSplitMenuItem" Text="{u:Loc Key=ViewModeSplitMenuItem_Text}" GroupName="ViewMode" Tag="split" Click="ViewModeMenuItem_Click"/>
                <MenuFlyoutSeparator/>
