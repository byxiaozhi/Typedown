                         long list or a short window none of them is squeezed out of reach; the Library, the
                         folder tree and the outline each collapse from their own heading. The narrow icon
                         strip keeps the navigation and hides SidebarLower. -->
                    <ScrollViewer x:Name="SidebarScroll" Grid.Row="1" Grid.RowSpan="4" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                    <StackPanel>
                    <!-- Two groups with headings (interface review D5): what you can start, and your files.
