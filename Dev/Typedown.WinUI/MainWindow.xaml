                            <StackPanel x:Name="SpeechMarksListPanel" Spacing="4"/>
                            <tk:SettingsCard Header="{u:Loc Key=SpeechRecipesHeader}" Description="{u:Loc Key=SpeechRecipesDescription}" Margin="0,12,0,0">
