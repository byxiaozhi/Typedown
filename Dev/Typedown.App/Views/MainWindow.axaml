<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="Typedown.App.Views.MainWindow"
        Title="Typedown"
        Width="1000" Height="700"
        MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica,AcrylicBlur"
        Background="Transparent"
        Icon="avares://Typedown.App/Assets/logo.png">

    <Window.Styles>
        <!-- ══ CRITICAL: Make FluentTheme window internals transparent for Mica ══ -->
        <!-- Force the Window template's layout root and background elements to be transparent -->
        <Style Selector="Window /template/ Panel#LayoutRoot">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Window /template/ Border#PART_TransparencyFallback">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Window /template/ Panel#BackgroundLayer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ══ Top-level menu items ══ -->
        <Style Selector="Menu > MenuItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Menu > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#15000000"/>
        </Style>
        <Style Selector="Menu > MenuItem:pressed /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#20000000"/>
        </Style>

        <!-- ══ Bottom bar buttons ══ -->
        <Style Selector="Button.bottomBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style Selector="Button.bottomBtn:pointerover">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.bottomBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#15000000"/>
        </Style>

        <!-- ══ Settings gear ══ -->
        <Style Selector="Button.settingsBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.settingsBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#15000000"/>
        </Style>
        <Style Selector="Button.settingsBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#20000000"/>
        </Style>

        <!-- ══ Sidebar tab styling ══ -->
        <Style Selector="Border.tabActive">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>
        <Style Selector="Border.tabInactive">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>
    </Window.Styles>

    <!-- ═══════════════════════════════════════ -->
    <!--  Root Layout                            -->
    <!-- ═══════════════════════════════════════ -->
    <DockPanel>

        <!-- ╔══ Row 2: Toolbar / Menu Bar ══╗ -->
        <Border DockPanel.Dock="Top" Padding="6,4,6,4" Background="#eff4f9">
            <DockPanel>
                <Button DockPanel.Dock="Right" Classes="settingsBtn" x:Name="MenuSettings"
                        ToolTip.Tip="设置" VerticalAlignment="Center" Margin="4,0,4,0">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               Text="&#xE713;" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Header="文件">
                        <MenuItem x:Name="MenuNewFile" Header="新建" InputGesture="Ctrl+N"/>
                        <Separator/>
                        <MenuItem x:Name="MenuOpenFile" Header="打开文件..." InputGesture="Ctrl+O"/>
                        <MenuItem x:Name="MenuOpenFolder" Header="打开文件夹..." InputGesture="Ctrl+Shift+O"/>
                        <Separator/>
                        <MenuItem x:Name="MenuSave" Header="保存" InputGesture="Ctrl+S"/>
                        <MenuItem x:Name="MenuSaveAs" Header="另存为..." InputGesture="Ctrl+Shift+S"/>
                        <Separator/>
                        <MenuItem x:Name="MenuExit" Header="退出" InputGesture="Alt+F4"/>
                    </MenuItem>
                    <MenuItem Header="编辑">
                        <MenuItem x:Name="MenuUndo" Header="撤销" InputGesture="Ctrl+Z"/>
                        <MenuItem x:Name="MenuRedo" Header="重做" InputGesture="Ctrl+Shift+Z"/>
                        <Separator/>
                        <MenuItem x:Name="MenuCut" Header="剪切" InputGesture="Ctrl+X"/>
                        <MenuItem x:Name="MenuCopy" Header="复制" InputGesture="Ctrl+C"/>
                        <MenuItem x:Name="MenuPaste" Header="粘贴" InputGesture="Ctrl+V"/>
                        <Separator/>
                        <MenuItem x:Name="MenuSelectAll" Header="全选" InputGesture="Ctrl+A"/>
                        <MenuItem x:Name="MenuFind" Header="查找替换" InputGesture="Ctrl+F"/>
                    </MenuItem>
                    <MenuItem Header="段落">
                        <MenuItem x:Name="MenuH1" Header="标题 1" InputGesture="Ctrl+1"/>
                        <MenuItem x:Name="MenuH2" Header="标题 2" InputGesture="Ctrl+2"/>
                        <MenuItem x:Name="MenuH3" Header="标题 3" InputGesture="Ctrl+3"/>
                        <MenuItem x:Name="MenuH4" Header="标题 4" InputGesture="Ctrl+4"/>
                        <MenuItem x:Name="MenuH5" Header="标题 5" InputGesture="Ctrl+5"/>
                        <MenuItem x:Name="MenuH6" Header="标题 6" InputGesture="Ctrl+6"/>
                        <Separator/>
                        <MenuItem x:Name="MenuTable" Header="表格"/>
                        <MenuItem x:Name="MenuCodeBlock" Header="代码块" InputGesture="Ctrl+Shift+K"/>
                        <MenuItem x:Name="MenuQuote" Header="引用" InputGesture="Ctrl+Shift+Q"/>
                        <MenuItem x:Name="MenuMathBlock" Header="公式块" InputGesture="Ctrl+Shift+M"/>
                        <MenuItem x:Name="MenuHorizontalRule" Header="水平线"/>
                        <Separator/>
                        <MenuItem x:Name="MenuOrderedList" Header="有序列表"/>
                        <MenuItem x:Name="MenuBulletList" Header="无序列表"/>
                        <MenuItem x:Name="MenuTaskList" Header="任务列表"/>
                    </MenuItem>
                    <MenuItem Header="格式">
                        <MenuItem x:Name="MenuBold" Header="加粗" InputGesture="Ctrl+B"/>
                        <MenuItem x:Name="MenuItalic" Header="斜体" InputGesture="Ctrl+I"/>
                        <MenuItem x:Name="MenuUnderline" Header="下划线" InputGesture="Ctrl+U"/>
                        <Separator/>
                        <MenuItem x:Name="MenuStrikethrough" Header="删除线" InputGesture="Ctrl+D"/>
                        <MenuItem x:Name="MenuInlineCode" Header="行内代码"/>
                        <MenuItem x:Name="MenuInlineMath" Header="行内公式" InputGesture="Ctrl+Shift+E"/>
                        <Separator/>
                        <MenuItem x:Name="MenuHyperlink" Header="超链接" InputGesture="Ctrl+L"/>
                        <MenuItem x:Name="MenuImage" Header="图片" InputGesture="Ctrl+Shift+I"/>
                        <Separator/>
                        <MenuItem x:Name="MenuClearFormat" Header="清除格式" InputGesture="Ctrl+Shift+R"/>
                    </MenuItem>
                    <MenuItem Header="查看">
                        <MenuItem x:Name="MenuSourceCode" Header="源代码模式" InputGesture="Ctrl+E"/>
                        <MenuItem x:Name="MenuSidebarToggle" Header="侧边栏" InputGesture="Ctrl+Shift+B"/>
                    </MenuItem>
                    <MenuItem Header="帮助">
                        <MenuItem x:Name="MenuAbout" Header="关于 Typedown"/>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <!-- ═══ Separator: toolbar → content ═══ -->
        <Border DockPanel.Dock="Top" Height="0.5"
                Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

        <!-- ╔══ Bottom Status Bar ══╗ -->
        <Border DockPanel.Dock="Bottom" Padding="4,2" Background="#D8F3F3F3"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0.5,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="1" DockPanel.Dock="Left"
                            VerticalAlignment="Center">
                    <Button x:Name="BtnHamburger" Classes="bottomBtn" Click="OnToggleSidebar"
                            ToolTip.Tip="切换侧边栏">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Text="&#xE700;" FontSize="14"/>
                    </Button>
                    <Button x:Name="BtnSourceMode" Classes="bottomBtn" Click="OnToggleSourceMode"
                            ToolTip.Tip="源代码模式">
                        <TextBlock Text="&lt;/&gt;" FontSize="11" FontFamily="Consolas, monospace"/>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="StatusWordCount" Text="0 字" FontSize="11.5"
                           Opacity="0.5" VerticalAlignment="Center"
                           DockPanel.Dock="Right" Margin="0,0,6,0"/>
                <Border/>
            </DockPanel>
        </Border>

        <!-- ╔══ Main Content (2-column: sidebar+border | editor) ══╗ -->
        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0" MinWidth="0" MaxWidth="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar: solid background + thin right border as separator -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,0,0.5,0">
                <DockPanel x:Name="SidebarPanel">
                    <!-- Tab row -->
                    <Border DockPanel.Dock="Top" Padding="14,0"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="0,0,0,0.5">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Border x:Name="TabFiles" Classes="tabActive" Padding="0,10,0,6"
                                    Cursor="Hand" Tapped="OnTabFilesClick">
                                <TextBlock Text="文件" FontSize="13" Opacity="0.9"/>
                            </Border>
                            <Border x:Name="TabOutline" Classes="tabInactive" Padding="0,10,0,6"
                                    Cursor="Hand" Tapped="OnTabOutlineClick">
                                <TextBlock Text="大纲" FontSize="13" Opacity="0.5"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- File tree -->
                    <TreeView x:Name="FileExplorer" Background="Transparent"
                              FontSize="13" Padding="4,8"/>
                </DockPanel>
            </Border>

            <!-- GridSplitter: thin transparent drag handle at column boundary -->
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="0"
                          HorizontalAlignment="Right" Width="4"
                          Background="Transparent" ResizeDirection="Columns"
                          IsVisible="False" Margin="0" Padding="0"/>

            <!-- Editor -->
            <Border Grid.Column="1" Background="Transparent">
                <NativeWebView x:Name="EditorWebView"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
