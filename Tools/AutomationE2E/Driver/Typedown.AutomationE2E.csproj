<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows end-to-end driver (docs/automation-api-analysis-plan.md, 10.6/10.7). Run by run-windows-e2e.ps1 in
       the logged-on desktop session against the automation test host. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- UI Automation (answering the app's dialogs through their buttons); buildable on Linux too. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Dev\Typedown.Automation\Typedown.Automation.csproj" />
    <!-- IU02 makes its bucket and reads the object back with the application's own signing. -->
    <Compile Include="..\..\..\Dev\Typedown.Core\Services\S3Uploader.cs" Link="S3Uploader.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The document with every kind of block the editor draws (Tools/EditorBench), for cases that need it all at once. -->
    <EmbeddedResource Include="..\..\EditorBench\fixtures\showcase\showcase.md" LogicalName="showcase.md" />
    <EmbeddedResource Include="..\..\EditorBench\fixtures\showcase\images\*" LogicalName="showcase-images/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
